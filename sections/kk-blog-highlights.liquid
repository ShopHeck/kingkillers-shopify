{%- comment -%}
  Homepage "latest articles" section. Native and CSS-only — it reuses the .kk-blog__*
  styles already shipped in kk-theme.css, so it adds no per-page weight. This replaces
  the AI-generated blog block (blocks/ai_gen_block_2ac85db.liquid), which emitted ~220
  lines of per-instance inline <style> plus a custom-element <script> that duplicated
  these very styles — inline CSS/JS isn't cached across pages and cost main-thread time.
{%- endcomment -%}
<section class="kk-section kk-blog" aria-labelledby="blog-hl-{{ section.id }}">
  <div class="kk-wrap">
    <header class="kk-blog__head">
      {%- if section.settings.eyebrow != blank -%}<p class="kk-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="kk-h2" id="blog-hl-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}<div class="kk-lead rte">{{ section.settings.subtext }}</div>{%- endif -%}
    </header>

    {%- assign blog = section.settings.blog -%}
    {%- if blog != blank and blog.articles_count > 0 -%}
      <div class="kk-blog__grid">
        {%- for article in blog.articles limit: section.settings.articles_to_show -%}
          <article class="kk-blog__card">
            {%- if article.image != blank -%}
              <a href="{{ article.url }}" class="kk-blog__media" aria-label="{{ article.title | escape }}">
                {% render 'responsive-image', image: article.image, sizes: '(max-width:750px) 100vw, 33vw', widths: '360, 540, 720', class: 'kk-blog__img' %}
                <span class="kk-blog__splatter" aria-hidden="true"></span>
              </a>
            {%- endif -%}
            <div class="kk-blog__info">
              {%- if section.settings.show_date -%}
                <span class="kk-blog__date">{{ article.published_at | time_tag: format: 'date' }}</span>
              {%- endif -%}
              <h3 class="kk-blog__name"><a href="{{ article.url }}">{{ article.title }}</a></h3>
              {%- if section.settings.show_excerpt -%}
                <p class="kk-blog__excerpt">
                  {%- if article.excerpt.size > 0 -%}
                    {{ article.excerpt | strip_html | truncatewords: 24 }}
                  {%- else -%}
                    {{ article.content | strip_html | truncatewords: 24 }}
                  {%- endif -%}
                </p>
              {%- endif -%}
              <a href="{{ article.url }}" class="kk-btn kk-btn--ghost kk-blog__btn">Read Article</a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if section.settings.cta_label != blank -%}
        <div class="kk-blog__foot">
          <a class="kk-btn kk-btn--ghost" href="{{ section.settings.cta_url | default: blog.url }}">{{ section.settings.cta_label }}</a>
        </div>
      {%- endif -%}
    {%- else -%}
      {%- comment -%} Editor fallback so the grid never looks empty before a blog is chosen. {%- endcomment -%}
      <div class="kk-blog__grid">
        {%- for i in (1..section.settings.articles_to_show) -%}
          <article class="kk-blog__card">
            <span class="kk-blog__media">{{ 'image' | placeholder_svg_tag: 'kk-blog__img' }}</span>
            <div class="kk-blog__info">
              {%- if section.settings.show_date -%}<span class="kk-blog__date">Coming soon</span>{%- endif -%}
              <h3 class="kk-blog__name">Example Article {{ i }}</h3>
              {%- if section.settings.show_excerpt -%}<p class="kk-blog__excerpt">Choose a blog in this section's settings to show your latest posts here.</p>{%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "KK Blog Highlights",
  "tag": "section",
  "enabled_on": { "templates": ["index", "page"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Intel & Training" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest from the Ring" },
    { "type": "richtext", "id": "subtext", "label": "Subtext", "default": "<p>Fighter stories, training tips, and brand updates.</p>" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "articles_to_show", "label": "Articles to show", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_date", "label": "Show publish date", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "View All Articles" },
    { "type": "url", "id": "cta_url", "label": "Button link", "info": "Leave blank to link to the selected blog." }
  ],
  "presets": [
    { "name": "KK Blog Highlights", "settings": { "articles_to_show": 3 } }
  ]
}
{% endschema %}
