{%- comment -%}
  PDP main section. Gallery (first image preloaded as LCP) + buy box with size pills,
  trust row, sticky ATC. Product & Breadcrumb JSON-LD + @app blocks for reviews/upsells.
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign hero_image = current_variant.featured_media.preview_image | default: product.featured_media.preview_image
  assign hero_alt = hero_image.alt | default: product.title
  assign variant_widths = '480,720,960,1200' | split: ','

  assign pdp_rating = 0
  assign pdp_has_rating = false
  if product.metafields.reviews.rating.value != blank
    assign pdp_has_rating = true
    assign pdp_rating = product.metafields.reviews.rating.value.rating | times: 1.0
    assign pdp_rating_pct = pdp_rating | divided_by: 5.0 | times: 100
  endif
-%}
<section class="kk-pdp kk-section" aria-labelledby="pdp-title" data-pdp>
  <div class="kk-wrap kk-pdp__grid">
    <div class="kk-pdp__gallery">
      {% render 'responsive-image', image: hero_image,
         sizes: '(max-width:750px) 100vw, 50vw', preload: true,
         widths: '480, 720, 960, 1200, 1600', class: 'kk-pdp__img', alt: hero_alt %}
      {%- if product.images.size > 1 -%}
        <div class="kk-pdp__thumbs">
          {%- for image in product.images -%}
            {%- comment -%}
              Clamp to the source width for the same reason the responsive-image snippet
              does: Shopify never upscales, so a "1600w" candidate on a 900px original
              is a 900px file the browser thinks is 1600px wide.
            {%- endcomment -%}
            {%- capture srcset_val -%}
              {%- for w in variant_widths -%}
                {%- assign wn = w | times: 1 -%}
                {%- if wn < image.width -%}{{ image | image_url: width: wn }} {{ wn }}w, {% endif -%}
              {%- endfor -%}
              {{ image | image_url: width: image.width }} {{ image.width }}w
            {%- endcapture -%}
            <button type="button" class="kk-pdp__thumb-btn{% if forloop.first %} is-active{% endif %}"
                    data-large-src="{{ image | image_url: width: 1200 }}"
                    data-large-srcset="{{ srcset_val | strip | escape }}"
                    aria-label="View product image {{ forloop.index }}">
              {% render 'responsive-image', image: image, sizes: '72px', widths: '72, 144, 216', class: 'kk-pdp__thumb', alt: product.title, eager_first: forloop.first %}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="kk-pdp__buybox">
      {%- if product.metafields.custom.badge != blank or product.tags contains 'Best Seller' or product.tags contains 'Made in USA' or product.tags contains 'Limited Drop' -%}
        <div class="kk-pdp__badges">
          {%- if product.metafields.custom.badge != blank -%}
            <span class="kk-pdp__badge">{{ product.metafields.custom.badge.value }}</span>
          {%- endif -%}
          {%- if product.tags contains 'Best Seller' -%}
            <span class="kk-pdp__badge">Best Seller</span>
          {%- endif -%}
          {%- if product.tags contains 'Made in USA' -%}
            <span class="kk-pdp__badge kk-pdp__badge--blood">Made in USA</span>
          {%- endif -%}
          {%- if product.tags contains 'Limited Drop' -%}
            <span class="kk-pdp__badge kk-pdp__badge--gold">Limited Drop</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if pdp_has_rating -%}
        <a class="kk-pdp__rating" href="#kk-reviews" aria-label="Rated {{ pdp_rating | round: 1 }} out of 5 from {{ product.metafields.reviews.rating_count.value }} reviews">
          <span class="kk-stars" style="--rating-fill: {{ pdp_rating_pct }}%" aria-hidden="true"></span>
          <span class="kk-pc__rev">{{ pdp_rating | round: 1 }} · {{ product.metafields.reviews.rating_count.value }} reviews</span>
        </a>

      {%- endif -%}

      <h1 id="pdp-title" class="kk-pdp__title">{{ product.title }}</h1>
      <div class="kk-pdp__price" data-pdp-price>
        <span>{{ current_variant.price | money }}</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <s>{{ current_variant.compare_at_price | money }}</s>
        {%- endif -%}
      </div>

      {% form 'product', product, class: 'kk-pdp__form', novalidate: 'novalidate' %}
        {%- unless product.has_only_default_variant -%}
          {%- assign default_variant = current_variant -%}

          <div class="kk-pdp__size" data-pdp-size>
            <div class="kk-pdp__size-head">
              <span class="kk-pdp__size-label">
                Select {{ product.options_with_values.first.name | default: 'Size' }}
                <span class="kk-pdp__size-current" data-pdp-size-label>
                  {%- if default_variant -%}{{ default_variant.title }}{%- else -%}Choose one{%- endif -%}
                </span>
              </span>
              {%- comment -%}
                Products with a configured size chart get the measurement table;
                everything else falls back to the prose block in the buy box.
              {%- endcomment -%}
              <a class="kk-pdp__size-guide" href="#{% if template.suffix == 'womens' and product.metafields.custom.size_chart_key != blank %}kk-size-chart{% else %}size-help{% endif %}">Size guide</a>
            </div>
            <div class="kk-pdp__pills" role="group" aria-label="Choose {{ product.options_with_values.first.name | default: 'size' }}">
              {%- for variant in product.variants -%}
                <button
                  type="button"
                  class="kk-pdp__pill{% if default_variant and variant.id == default_variant.id %} is-selected{% endif %}{% unless variant.available %} is-soldout{% endunless %}"

                  aria-pressed="{% if default_variant and variant.id == default_variant.id %}true{% else %}false{% endif %}"
                  data-pdp-pill
                  data-variant-id="{{ variant.id }}"
                  data-title="{{ variant.title | escape }}"
                  aria-label="{{ variant.title | escape }}{% unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}"

                >
                  {{ variant.title }}
                </button>
              {%- endfor -%}
            </div>
          </div>

          <select name="id" class="kk-pdp__variants kk-pdp__variants--sr" aria-label="Variant" data-pdp-variant>
            {%- for variant in product.variants -%}
              {%- comment -%}
                Only emit swap data when the variant has its OWN media. Size variants
                share the product's featured image, so repeating a five-URL srcset for
                each of them just inflates the HTML — and kk.js correctly leaves the
                gallery alone when there is nothing to swap to.
              {%- endcomment -%}
              {%- assign var_image = variant.featured_media.preview_image -%}
              {%- if var_image != blank -%}
                {%- capture var_srcset -%}
                  {%- for w in variant_widths -%}
                    {%- assign wn = w | times: 1 -%}
                    {%- if wn < var_image.width -%}{{ var_image | image_url: width: wn }} {{ wn }}w, {% endif -%}
                  {%- endfor -%}
                  {{ var_image | image_url: width: var_image.width }} {{ var_image.width }}w
                {%- endcapture -%}
              {%- endif -%}
              <option value="{{ variant.id }}"
                      data-price="{{ variant.price | money }}"
                      data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
                      data-available="{{ variant.available }}"
                      data-quantity-max="{% if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' %}{{ variant.inventory_quantity }}{% endif %}"
                      {% if var_image != blank %}data-image="{{ var_image | image_url: width: 1200 }}"
                      data-srcset="{{ var_srcset | strip | escape }}"{% endif %}
                      {% if default_variant and variant.id == default_variant.id %}selected{% endif %}
                      >
                {{ variant.title }} – {{ variant.price | money }}{% unless variant.available %} (Sold out){% endunless %}
              </option>
            {%- endfor -%}
          </select>
        {%- else -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}"
                 data-available="{{ current_variant.available }}"
                 data-quantity-max="{% if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny' %}{{ current_variant.inventory_quantity }}{% endif %}"
                 data-pdp-variant>
        {%- endunless -%}

        <div class="kk-pdp__purchase">
          <div class="kk-pdp__quantity" data-pdp-quantity>
            <label for="Quantity-{{ section.id }}">Quantity</label>
            <div class="kk-pdp__quantity-control">
              <button type="button" data-pdp-quantity-change="-1" aria-label="Decrease quantity" aria-controls="Quantity-{{ section.id }}" disabled>&minus;</button>
              <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" step="1" inputmode="numeric" autocomplete="off" aria-label="Product quantity" data-pdp-quantity-input>
              <button type="button" data-pdp-quantity-change="1" aria-label="Increase quantity" aria-controls="Quantity-{{ section.id }}">&plus;</button>
            </div>
          </div>
          <button type="submit" class="kk-btn kk-btn--primary kk-btn--full" data-pdp-submit {% unless current_variant.available %}disabled{% endunless %}>
            {% if current_variant.available %}Add to Cart{% else %}Sold Out{% endif %}
          </button>
        </div>
        <p class="kk-form-error" data-cart-error role="alert" hidden></p>
      {% endform %}

      {%- unless product.available -%}
      <div class="kk-notify kk-notify--pdp" data-notify id="kk-notify">
        <p class="kk-notify__title">This one's gone — get first dibs when it's back.</p>
        {%- form 'customer', class: 'kk-notify__form' -%}
          <input type="hidden" name="contact[tags]" value="notify-me, {{ product.title | escape }}">
          <input type="email" name="contact[email]" placeholder="your@email.com" required aria-label="Email for restock alert on {{ product.title | escape }}">
          <button type="submit" class="kk-btn kk-btn--primary">Notify Me</button>
        {%- endform -%}
      </div>
      {%- endunless -%}

      <ul class="kk-pdp__trustrow" aria-label="Purchase benefits">
        <li><strong>Free shipping $100+</strong><span>Stack gear and save on delivery</span></li>
        <li><strong>{{ 'storefront.shipping.title' | t }}</strong><span><a href="{{ shop.shipping_policy.url }}">{{ 'storefront.shipping.details' | t }}</a></span></li>
        <li><strong>{{ 'storefront.returns.title' | t }}</strong><span><a href="{{ shop.refund_policy.url }}">{{ 'storefront.returns.eligibility' | t }}</a></span></li>
        <li><strong>Fighter owned</strong><span>Designed by real BJJ, boxing &amp; MMA athletes</span></li>
      </ul>

      <div class="kk-pdp__trust" aria-label="Product trust and fit details">
        <details class="kk-pdp__detail" id="size-help" open>
          <summary>Size &amp; fit help</summary>
          {% render 'product-fit-guide', product: product, section: section %}
        </details>
        <details class="kk-pdp__detail">
          <summary>Shipping &amp; returns</summary>
          {% render 'purchase-policy' %}
        </details>
        <details class="kk-pdp__detail">
          <summary>Secure checkout</summary>
          <div class="rte">{{ section.settings.checkout_reassurance }}</div>
        </details>
      </div>

      {%- if section.settings.show_scarcity -%}
        <p class="kk-pdp__scarcity" data-pdp-stock data-stock-threshold="{{ section.settings.scarcity_threshold | default: 10 }}"{% unless current_variant.available and current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= section.settings.scarcity_threshold %} hidden{% endunless %}>{{ 'storefront.product.remaining' | t: count: current_variant.inventory_quantity }}</p>
      {%- endif -%}

      <div id="product-details" class="kk-pdp__desc rte">{{ product.description }}</div>

      <div id="kk-reviews" class="kk-pdp__apps">
        {%- assign has_review_block = false -%}
        {%- for block in section.blocks -%}{%- if block.type contains 'judgeme' or block.type contains 'judge-me' -%}{%- assign has_review_block = true -%}{%- endif -%}{%- endfor -%}
        {%- if section.settings.enable_judgeme_reviews != false and has_review_block == false -%}{% render 'product-reviews', product: product %}{%- endif -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}{% render block %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
  <div class="kk-pdp__sticky" data-pdp-sticky hidden aria-label="Quick add to cart">
    <div class="kk-pdp__sticky-info">
      <strong>{{ product.title }}</strong>
      <span data-pdp-sticky-variant>{% unless product.has_only_default_variant %}{{ current_variant.title | escape }}{% endunless %}</span>
      <span data-pdp-sticky-price>{{ current_variant.price | money }}</span>
    </div>
    <button type="button" class="kk-btn kk-btn--primary" data-pdp-sticky-submit {% unless current_variant.available %}disabled{% endunless %}>
      {% if current_variant.available %}Add to Cart{% else %}Sold Out{% endif %}
    </button>
  </div>
</section>

{% render 'structured-data-product', product: product %}
{% render 'structured-data-breadcrumb', product: product, collection: collection %}

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "size_chart",
      "label": "Product measurement chart",
      "info": "Connect a product-specific file metafield dynamic source. Use the approved supplier chart for this exact product."
    },
    {
      "type": "checkbox",
      "id": "show_scarcity",
      "label": "Show low stock indicator",
      "default": true
    },
    {
      "type": "range",
      "id": "scarcity_threshold",
      "label": "Low stock threshold",
      "min": 2,
      "max": 30,
      "step": 1,
      "default": 10
    },
    {
      "type": "richtext",
      "id": "checkout_reassurance",
      "label": "Checkout reassurance",
      "default": "<p>Secure checkout with major cards and accelerated payment options where available. Fighter-owned brand based in Tampa / St. Petersburg, Florida.</p>"
    },
    {
      "type": "checkbox",
      "id": "enable_judgeme_reviews",
      "label": "Built-in Judge.me review widget",
      "default": true,
      "info": "Turn off when adding a Judge.me Review Widget app block to avoid duplicate reviews."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
