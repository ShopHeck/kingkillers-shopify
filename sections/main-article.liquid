{%- assign featured_filename = article.image.src | split: '/' | last | split: '?' | first -%}
{%- assign show_author = true -%}
{%- if article.author == 'Shopify API' or article.author == blank -%}{%- assign show_author = false -%}{%- endif -%}
{%- comment -%}
  Main article template rendering full post content.
{%- endcomment -%}
<article class="kk-section kk-art" aria-labelledby="art-title">
  <div class="kk-wrap kk-wrap--narrow">
    <header class="kk-art__head">
      <a href="{{ blog.url }}" class="kk-art__back">&larr; Back to {{ blog.title }}</a>
      <span class="kk-art__date">{{ article.published_at | time_tag: format: 'date' }}{% if show_author %} · by {{ article.author | escape }}{% endif %}</span>
      <h1 id="art-title" class="kk-h2 kk-art__title">{{ article.title }}</h1>
    </header>

    {%- if article.image != blank -%}
      {%- unless article.content contains featured_filename -%}
      <div class="kk-art__media">
        {% render 'responsive-image', image: article.image, sizes: '(max-width:750px) 100vw, 80vw', widths: '480, 720, 960, 1440', class: 'kk-art__img', preload: true %}
      </div>
      {%- endunless -%}
    {%- endif -%}

    {% render 'journal-navigation' %}
    <div class="kk-art__content rte">
      {{ article.content }}
    </div>
    {% if section.settings.products != blank %}
      <aside class="kk-art__shop" aria-labelledby="article-shop-title">
        <h2 id="article-shop-title" class="kk-h3">{{ 'storefront.blog.shop' | t }}</h2>
        <div class="kk-best__grid">{% for item in section.settings.products %}{% render 'product-card', product: item %}{% endfor %}</div>
      </aside>
    {% endif %}
  </div>
</article>

{% schema %}
{
  "name": "Article content",
  "tag": "section",
  "enabled_on": { "templates": ["article"] },
  "settings": [{"type":"product_list","id":"products","label":"Products featured in this article","limit":4,"info":"Connect a product-list dynamic source to select relevant products for each article."}]
}
{% endschema %}

{%- comment -%} BlogPosting + BreadcrumbList schema for rich results {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ article.title | truncate: 110 | json }},
  "description": {{ article.excerpt_or_content | strip_html | truncate: 160 | json }},
  {%- comment -%}
    Guard the image: piping a blank article.image through image_url and prepending
    "https:" produced the literal string "https:", an invalid URL that fails
    validation on every post without a featured image.
  {%- endcomment -%}
  {%- if article.image != blank -%}
  "image": [{{ article.image | image_url: width: 1200 | prepend: "https:" | json }}],
  {%- endif -%}
  "datePublished": {{ article.published_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
  "dateModified": {{ article.updated_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
  {% if show_author %}"author": { "@type": "Person", "name": {{ article.author | json }} },{% endif %}
  "publisher": { "@id": {{ shop.url | append: '/#organization' | json }} },
  "isPartOf": { "@type": "Blog", "name": {{ blog.title | json }}, "@id": {{ shop.url | append: blog.url | append: '#blog' | json }} },
  "mainEntityOfPage": { "@type": "WebPage", "@id": {{ shop.url | append: article.url | json }} }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
    { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ shop.url | append: blog.url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ shop.url | append: article.url | json }} }
  ]
}
</script>

<script data-kk-art-dedupe>
(function(){
  var first=document.getElementById('art-title');
  if(!first)return;
  var scope=document.querySelector('.kk-art__content')||document;
  var h1s=scope.querySelectorAll('h1');
  for(var i=0;i<h1s.length;i++){
    if(h1s[i]!==first){var d=document.createElement('p');d.className='kk-h3';d.style.fontWeight='700';
      while(h1s[i].firstChild)d.appendChild(h1s[i].firstChild);
      h1s[i].parentNode.replaceChild(d,h1s[i]);}
  }
})();
</script>
