{%- comment -%}
  Below-grid editorial/SEO content. Sources collection.metafields.custom.seo_copy (html).
  Renders nothing when the metafield is empty, so untouched collections are unaffected.
  Also emits CollectionPage + ItemList JSON-LD for rich results / AI answer engines.
{%- endcomment -%}
{%- assign seo_copy = collection.metafields.custom.seo_copy.value -%}
{%- if seo_copy != blank -%}
  <section class="kk-section kk-seocopy" aria-label="About this collection">
    <div class="kk-wrap">{{ seo_copy }}</div>
  </section>
{%- endif -%}

{%- capture kk_collection_schema -%}
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ collection.title | json }},
  "description": {{ collection.description | strip_html | truncate: 300 | json }},
  "url": {{ shop.url | append: collection.url | json }},
  "isPartOf": { "@type": "WebSite", "name": {{ shop.name | json }}, "url": {{ shop.url | json }} }
}
{%- endcapture -%}
<script type="application/ld+json">{{ kk_collection_schema | strip_newlines }}</script>

{% schema %}
{
  "name": "KK Collection copy",
  "tag": "div",
  "enabled_on": { "templates": ["collection"] },
  "settings": []
}
{% endschema %}
