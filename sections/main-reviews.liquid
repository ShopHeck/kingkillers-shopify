{%- comment -%}
  Dedicated customer-reviews page. The score, count, and review body come from
  Judge.me shop metafields so the visible page remains factual and crawlable.
  Do not add Organization/AggregateRating markup here: Google treats a brand's
  own review page as self-serving and does not award review snippets for it.
{%- endcomment -%}
{%- liquid
  assign review_rating = shop.metafields.judgeme.all_reviews_rating
  assign review_count = shop.metafields.judgeme.all_reviews_count
  assign review_count_number = review_count | plus: 0
  assign rating_number = review_rating | times: 1.0
  assign rating_percent = rating_number | times: 20
  assign has_reviews = false
  if review_count_number > 0 and rating_number > 0
    assign has_reviews = true
  endif
-%}

<section class="kk-reviews-page" aria-labelledby="reviews-page-{{ section.id }}">
  <header class="kk-reviews-page__hero">
    <div class="kk-wrap">
      <nav class="kk-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><span aria-current="page">{{ page.title }}</span>
      </nav>
      <div class="kk-reviews-page__hero-grid">
        <div class="kk-reviews-page__intro">
          {%- if section.settings.eyebrow != blank -%}<p class="kk-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h1 id="reviews-page-{{ section.id }}">{{ section.settings.heading | default: page.title }}</h1>
          {%- if section.settings.intro != blank -%}<div class="kk-reviews-page__lead rte">{{ section.settings.intro }}</div>{%- endif -%}
          <div class="kk-reviews-page__actions">
            <a class="kk-btn kk-btn--primary" href="#customer-reviews">Read reviews</a>
            <a class="kk-btn kk-btn--ghost" href="{{ section.settings.shop_url | default: routes.all_products_collection_url }}">Shop the gear</a>
          </div>
        </div>

        <div class="kk-reviews-page__scorecard" aria-label="King Killers customer review score">
          <span class="kk-reviews-page__score-label">Customer score</span>
          {%- if has_reviews -%}
            <strong>{{ rating_number | round: 2 }}</strong>
            <span class="kk-reviews-page__out-of">out of 5</span>
            <span class="kk-reviews-page__stars" style="--rating-fill: {{ rating_percent }}%" role="img" aria-label="Rated {{ rating_number | round: 2 }} out of 5"><span aria-hidden="true">★★★★★</span></span>
            <span class="kk-reviews-page__count">Based on {{ review_count_number }} published reviews</span>
          {%- else -%}
            <strong class="kk-reviews-page__score-word">Real</strong>
            <span class="kk-reviews-page__out-of">customer feedback</span>
          {%- endif -%}
          <span class="kk-reviews-page__score-source">Live data from Judge.me</span>
        </div>
      </div>
    </div>
  </header>

  <div class="kk-wrap kk-reviews-page__proof" aria-label="About these reviews">
    <div><span>01</span><strong>Product + store reviews</strong><p>Feedback covers individual products and the overall buying experience.</p></div>
    <div><span>02</span><strong>Verification shown</strong><p>Purchase-verification labels are supplied by the independent review platform.</p></div>
    <div><span>03</span><strong>Current, not hard-coded</strong><p>The score and review count update from the store’s published review data.</p></div>
  </div>

  <div id="customer-reviews" class="kk-wrap kk-reviews-page__reviews" tabindex="-1">
    <div class="kk-reviews-page__section-head">
      <div>
        <p class="kk-eyebrow">The full record</p>
        <h2>Read customer reviews</h2>
      </div>
      <p>Filter, sort, and open product links inside the review feed to find feedback relevant to the gear you are considering.</p>
    </div>

    <div id="judgeme_all_reviews_page" class="kk-reviews-page__widget-shell page clearfix jdgm-all-reviews-page">
      <div class="jdgm-all-reviews-page__wrapper">
        {%- assign has_legacy_reviews = false -%}
        {%- if shop.metafields.judgeme.all_reviews_header.size > 20 -%}{%- assign has_legacy_reviews = true -%}{%- endif -%}
        <div class="jdgm-widget jdgm-all-reviews-widget-v2025" data-widget="all-reviews-v2025" data-auto-install="false" data-entry-point="all_reviews_widget_v2025.js" data-entry-key="all-reviews-widget-v2025/main.js">
          {%- if has_legacy_reviews -%}
            <div class="jdgm-legacy-widget-content" style="display:none">
              <article class="jdgm-widget jdgm-all-reviews-widget">
                <style class="jdgm-temp-hiding-style">.jdgm-all-reviews-widget{display:none}</style>
                {{ shop.metafields.judgeme.all_reviews_header }}
                <div class="jdgm-all-reviews__body">
                  {%- assign review_prefix = 'all_reviews_' -%}
                  {%- for review_index in (0..65535) -%}
                    {%- assign review_metafield_key = review_prefix | append: review_index -%}
                    {%- assign current_review_metafield = shop.metafields.judgeme[review_metafield_key] -%}
                    {%- unless current_review_metafield -%}{%- break -%}{%- endunless -%}
                    {{ current_review_metafield }}
                  {%- endfor -%}
                </div>
              </article>
            </div>
          {%- endif -%}
        </div>
        {%- if shop.metafields.judgeme.all_reviews_widget_v2025_data -%}
          <script>window.jdgm=window.jdgm||{};window.jdgm.data=window.jdgm.data||{};window.jdgm.data.allReviewsWidgetV2025={{ shop.metafields.judgeme.all_reviews_widget_v2025_data }};</script>
        {%- endif -%}
        {%- unless has_legacy_reviews or shop.metafields.judgeme.all_reviews_widget_v2025_data -%}
          <div class="kk-reviews-page__widget-empty">
            {%- if request.design_mode -%}
              <strong>Judge.me review data will appear here.</strong>
              <p>Keep the Judge.me app embed enabled for this theme.</p>
            {%- else -%}
              <strong>Reviews are loading.</strong>
              <p>If the feed does not appear, refresh the page or contact support.</p>
            {%- endif -%}
          </div>
        {%- endunless -%}
      </div>
    </div>
  </div>

  <div class="kk-wrap">
    <aside class="kk-reviews-page__standards" aria-labelledby="review-standards-{{ section.id }}">
      <div>
        <p class="kk-eyebrow">How reviews work</p>
        <h2 id="review-standards-{{ section.id }}">The honest scorecard</h2>
      </div>
      <div class="kk-reviews-page__standards-copy">
        <p>Reviews are submitted by customers through Judge.me. Verification labels are controlled by the review platform, and King Killers may publicly reply when context or support is helpful.</p>
        <p>Some customers may receive a reward for a future purchase after leaving a review. A positive rating is not required. Published feedback can include critical experiences as well as praise.</p>
      </div>
    </aside>
  </div>
</section>

{% render 'structured-data-page-breadcrumb' %}

{% schema %}
{
  "name": "Customer reviews page",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fighter tested · Customer scored" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer reviews. The gear gets judged here." },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Unfiltered product and store feedback from people who bought King Killers gear. Read the wins, the critiques, and the details that help you choose with confidence.</p>" },
    { "type": "url", "id": "shop_url", "label": "Shop link" }
  ],
  "presets": [
    { "name": "Customer reviews page" }
  ]
}
{% endschema %}
