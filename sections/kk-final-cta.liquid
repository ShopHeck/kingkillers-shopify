
<section class="kk-finalcta kk-section" aria-labelledby="finalcta-{{ section.id }}">
  {%- if section.settings.bg_word != blank -%}<div class="kk-finalcta__bg" aria-hidden="true">{{ section.settings.bg_word }}</div>{%- endif -%}
  <div class="kk-wrap kk-finalcta__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="kk-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="kk-h2 kk-finalcta__title" id="finalcta-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- if section.settings.sub != blank -%}<div class="kk-finalcta__sub rte">{{ section.settings.sub }}</div>{%- endif -%}
    <div class="kk-finalcta__btns">
      {%- if section.settings.cta1_label != blank -%}<a class="kk-btn kk-btn--primary" href="{{ section.settings.cta1_url }}">{{ section.settings.cta1_label }}</a>{%- endif -%}
      {%- if section.settings.cta2_label != blank -%}<a class="kk-btn kk-btn--ghost" href="{{ section.settings.cta2_url }}">{{ section.settings.cta2_label }}</a>{%- endif -%}
    </div>
    {%- if section.settings.fine != blank -%}<p class="kk-finalcta__fine">{{ section.settings.fine }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "KK Final CTA",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "bg_word", "label": "Background word", "default": "KING KILLERS" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ready to Hunt Kings?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stop Blending In. Start Standing Out." },
    { "type": "richtext", "id": "sub", "label": "Subtext",
      "default": "<p>Join the athletes who train, fight and live in fighter-built gear. Free shipping over $100 · 30-day money-back guarantee.</p>" },
    { "type": "text", "id": "cta1_label", "label": "Primary button", "default": "Shop Best Sellers" },
    { "type": "url", "id": "cta1_url", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button", "default": "Browse the Catalog" },
    { "type": "url", "id": "cta2_url", "label": "Secondary link" },
    { "type": "text", "id": "fine", "label": "Fine print", "default": "No risk. If it's not your best gear, send it back within 30 days." }
  ],
  "presets": [ { "name": "KK Final CTA" } ]
}
{% endschema %}
