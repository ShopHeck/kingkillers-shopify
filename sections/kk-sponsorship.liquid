{%- comment -%}
  Fighter Sponsorship Program Landing Page & Application Form
{%- endcomment -%}
<section class="kk-section kk-spon" aria-labelledby="spon-title">
  <div class="kk-wrap kk-wrap--narrow">
    <header class="kk-spon__head">
      <span class="kk-eyebrow">Fighter Program</span>
      <h1 id="spon-title" class="kk-h2">{{ page.title | default: 'Join the King Killers Team' }}</h1>
      <p class="kk-lead">We build gear for athletes who hunt the top. If you are an active fighter (MMA, BJJ, Boxing, Muay Thai) or a coach, apply to represent the brand.</p>
    </header>

    <div class="kk-spon__tiers">
      <div class="kk-spon__tier">
        <h3 class="kk-spon__tier-title">Tier 1: Affiliate</h3>
        <p class="kk-spon__tier-desc">Get a custom discount code for your followers/gym, and earn 10% commission on every sale you refer.</p>
      </div>
      <div class="kk-spon__tier">
        <h3 class="kk-spon__tier-title">Tier 2: Sponsored</h3>
        <p class="kk-spon__tier-desc">Free gear drops for your training camps, heavy discounts, and priority coverage on our social channels.</p>
      </div>
      <div class="kk-spon__tier">
        <h3 class="kk-spon__tier-title">Tier 3: Elite</h3>
        <p class="kk-spon__tier-desc">Custom walkout gear, photoshoot opportunities, direct sponsorship support, and bonuses for tournament finishes.</p>
      </div>
    </div>

    <div class="kk-spon__form-wrapper">
      <h2 class="kk-spon__form-title">Apply for Sponsorship</h2>
      {%- form 'contact', id: 'SponsorshipForm', class: 'kk-spon__form' -%}
        {%- if form.posted_successfully? -%}
          <div class="kk-spon__success">
            <p>✓ Application submitted successfully! Our team will review your profile and reach out within 5-7 business days.</p>
          </div>
        {%- elsif form.errors -%}
          <div class="kk-spon__error">
            <p>Error submitting form. Please verify the fields and try again.</p>
          </div>
        {%- endif -%}

        <input type="hidden" name="contact[tags]" value="Fighter Sponsorship Applicant">

        <div class="kk-spon__field-group">
          <label class="kk-spon__label">Full Name
            <input type="text" name="contact[name]" required placeholder="Michael Heckert" class="kk-spon__input">
          </label>
          <label class="kk-spon__label">Email Address
            <input type="email" name="contact[email]" required placeholder="heck@kingkillers.co" class="kk-spon__input">
          </label>
        </div>

        <div class="kk-spon__field-group">
          <label class="kk-spon__label">Primary Sport
            <select name="contact[sport]" class="kk-spon__input kk-spon__select">
              <option value="MMA">Mixed Martial Arts (MMA)</option>
              <option value="BJJ">Brazilian Jiu-Jitsu (BJJ)</option>
              <option value="Boxing">Boxing</option>
              <option value="Muay Thai">Muay Thai / Kickboxing</option>
              <option value="Wrestling">Wrestling</option>
              <option value="Other">CrossFit / General Athletic</option>
            </select>
          </label>
          <label class="kk-spon__label">Record / Belt Rank
            <input type="text" name="contact[rank]" placeholder="e.g. Purple Belt, 3-1 Amateur MMA" class="kk-spon__input">
          </label>
        </div>

        <label class="kk-spon__label">Home Gym / Academy Name
          <input type="text" name="contact[gym]" required placeholder="e.g. Tampa Combat Sports" class="kk-spon__input">
        </label>

        <label class="kk-spon__label">Instagram or Social Media Handle
          <input type="text" name="contact[social]" required placeholder="e.g. @heck_fighters" class="kk-spon__input">
        </label>

        <label class="kk-spon__label">Why do you want to represent King Killers?
          <textarea name="contact[body]" rows="5" placeholder="Tell us about your next fight camp, career goals, and what 'Real Kings Kill Kings' means to you." class="kk-spon__input kk-spon__textarea"></textarea>
        </label>

        <button type="submit" class="kk-btn kk-btn--primary kk-btn--full">Submit Application</button>
      {%- endform -%}
    </div>
  </div>
</section>

<style>
  .kk-spon__tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 40px 0 60px; }
  .kk-spon__tier { background: var(--bg-card); border: 1px solid var(--line); padding: 24px; border-radius: 14px; text-align: center; }
  .kk-spon__tier-title { font-family: var(--display); font-weight: 800; font-size: 1.1rem; text-transform: uppercase; color: var(--blood); margin: 0 0 10px; }
  .kk-spon__tier-desc { font-size: .88rem; color: var(--ink-dim); line-height: 1.5; margin: 0; }
  .kk-spon__form-wrapper { background: var(--bg-card); border: 1px solid var(--line-strong); padding: 40px; border-radius: 20px; box-shadow: var(--shadow); }
  .kk-spon__form-title { font-family: var(--display); font-weight: 900; font-size: 1.8rem; text-transform: uppercase; text-align: center; margin: 0 0 30px; }
  .kk-spon__field-group { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .kk-spon__label { display: flex; flex-direction: column; gap: 8px; font-family: var(--display); font-weight: 800; font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-dim); margin-bottom: 22px; width: 100%; }
  .kk-spon__input { background: var(--bg); border: 1px solid var(--line-strong); border-radius: 8px; color: var(--ink); padding: 12px 16px; font-size: 1rem; width: 100%; transition: border-color .18s; }
  .kk-spon__input:focus { border-color: var(--blood); outline: none; }
  .kk-spon__select { appearance: none; -webkit-appearance: none; background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 5'%3E%3Cpath fill='%23a8a8b0' d='M2 0L0 2h4zm0 5L0 3h4z'/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: right 16px center; background-size: 8px 10px; }
  .kk-spon__textarea { resize: vertical; font-family: var(--body); }
  .kk-spon__success { background: rgba(30, 200, 80, 0.12); border: 1px solid rgb(30, 200, 80); color: #8ef29e; padding: 16px 20px; border-radius: 8px; margin-bottom: 24px; font-size: .95rem; }
  .kk-spon__error { background: rgba(225, 19, 19, 0.12); border: 1px solid var(--blood); color: #ff8e8e; padding: 16px 20px; border-radius: 8px; margin-bottom: 24px; font-size: .95rem; }

  @media (max-width: 768px) {
    .kk-spon__tiers { grid-template-columns: 1fr; gap: 16px; }
    .kk-spon__field-group { grid-template-columns: 1fr; gap: 0; }
    .kk-spon__form-wrapper { padding: 24px; }
  }
</style>

{% schema %}
{
  "name": "Sponsorship application",
  "tag": "section",
  "enabled_on": { "templates": ["page"] },
  "settings": []
}
{% endschema %}
