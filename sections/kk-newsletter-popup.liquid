{%- comment -%}
  Welcome email-capture popup. DISABLED by default — enable it in the theme editor
  (Footer group → Newsletter popup → Enable popup). Uses a native {% form 'customer' %}
  so signups land in Shopify customers with marketing consent (works with Shopify Email,
  Klaviyo, etc.). kk.js handles the delayed open, one-time suppression (localStorage),
  focus trap, and — only for signups made from THIS popup — a success state that can
  reveal an optional discount code. No external dependencies; nothing renders when off.
{%- endcomment -%}
{%- if section.settings.enable -%}
  <div class="kk-np" data-np data-delay="{{ section.settings.delay | default: 6 }}" data-frequency="{{ section.settings.frequency_days | default: 14 }}" hidden>
    <div class="kk-np__overlay" data-np-close></div>
    <div class="kk-np__panel" role="dialog" aria-modal="true" aria-labelledby="kk-np-title">
      <button type="button" class="kk-np__x" data-np-close aria-label="Close">&times;</button>
      {%- if section.settings.image != blank -%}
        <div class="kk-np__media" aria-hidden="true">
          {{ section.settings.image | image_url: width: 900 | image_tag:
             widths: '450, 700, 900', sizes: '(max-width:600px) 100vw, 300px',
             loading: 'lazy', class: 'kk-np__img', alt: '' }}
        </div>
      {%- endif -%}
      <div class="kk-np__body">
        {%- form 'customer', id: 'kk-np-form', class: 'kk-np__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter, welcome-popup">
          {%- if form.posted_successfully? -%}
            <div class="kk-np__success" data-np-success>
              <p class="kk-eyebrow">You're in</p>
              <h2 class="kk-np__title" id="kk-np-title">{{ section.settings.success_heading | default: 'Welcome to the ranks.' }}</h2>
              {%- if section.settings.discount_code != blank -%}
                <p class="kk-np__desc">Use this code at checkout:</p>
                <p class="kk-np__code" data-np-code>{{ section.settings.discount_code }}</p>
                {%- if section.settings.discount_text != blank -%}<p class="kk-np__fine">{{ section.settings.discount_text }}</p>{%- endif -%}
              {%- endif -%}
              {%- if section.settings.success_text != blank -%}<p class="kk-np__desc">{{ section.settings.success_text }}</p>{%- endif -%}
              <button type="button" class="kk-btn kk-btn--primary kk-btn--full" data-np-close>Start Shopping</button>
            </div>
          {%- else -%}
            {%- if section.settings.eyebrow != blank -%}<p class="kk-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
            <h2 class="kk-np__title" id="kk-np-title">{{ section.settings.heading | default: 'Join the Ranks' }}</h2>
            {%- if section.settings.text != blank -%}<p class="kk-np__desc">{{ section.settings.text }}</p>{%- endif -%}
            <div class="kk-np__row">
              <input type="email" name="contact[email]" class="kk-np__input" placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}" aria-label="Email address" autocomplete="email" required>
              <button type="submit" class="kk-btn kk-btn--primary kk-np__submit">{{ section.settings.button | default: 'Sign Me Up' }}</button>
            </div>
            {%- if form.errors -%}
              <p class="kk-np__err" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
            <button type="button" class="kk-np__decline" data-np-close>No thanks</button>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Newsletter popup",
  "settings": [
    { "type": "paragraph", "content": "A first-visit email-capture popup. Off by default — turn it on below. If you want to offer a discount, create the matching code in Shopify → Discounts first, then enter it here." },
    { "type": "checkbox", "id": "enable", "label": "Enable popup", "default": false },
    { "type": "image_picker", "id": "image", "label": "Image (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fighter Owned · Designed for Training" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Ranks" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Get first access to new drops, fighter stories, and members-only deals — straight to your inbox." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button", "label": "Button label", "default": "Sign Me Up" },
    { "type": "header", "content": "Discount (optional)" },
    { "type": "text", "id": "discount_code", "label": "Discount code", "info": "Shown after signup. Create the matching code in Shopify → Discounts. Leave blank for no offer." },
    { "type": "text", "id": "discount_text", "label": "Discount fine print", "default": "10% off your first order. One use per customer." },
    { "type": "header", "content": "Success message" },
    { "type": "text", "id": "success_heading", "label": "Heading", "default": "Welcome to the ranks." },
    { "type": "textarea", "id": "success_text", "label": "Text", "default": "Keep an eye on your inbox for first access to new drops." },
    { "type": "header", "content": "Behavior" },
    { "type": "range", "id": "delay", "label": "Show after", "min": 0, "max": 30, "step": 1, "unit": "s", "default": 6 },
    { "type": "range", "id": "frequency_days", "label": "Don't show again for", "min": 1, "max": 60, "step": 1, "unit": "d", "default": 14 }
  ],
  "presets": [
    { "name": "Newsletter popup" }
  ]
}
{% endschema %}
