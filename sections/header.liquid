
{%- comment -%}
  Header with mega menu. Renders the merchant's linked list up to 3 levels deep so
  EVERY menu item is reachable: top-level triggers open a full-width mega panel on
  desktop (CSS hover + JS for touch / keyboard / a11y) and an accordion on mobile.
  Optional promo blocks merchandise a collection inside a panel, matched by the
  top-level item's title. Predictive search + account are opt-in. JS is deferred.
{%- endcomment -%}
<header class="kk-header" data-header>
  <div class="kk-wrap kk-header__inner">
    <a class="kk-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 280 | image_tag:
           widths: '140, 200, 280', sizes: '140px', loading: 'eager', alt: shop.name }}
      {%- else -%}
        <span class="kk-logo"><span class="kk-logo__mark" aria-hidden="true">K</span><span class="kk-logo__text">KING<span>KILLERS</span></span></span>
      {%- endif -%}
    </a>

    <nav class="kk-header__nav" aria-label="Primary">
      <ul class="kk-nav" data-nav-root>
        {%- for link in section.settings.menu.links -%}
          {%- if link.links.size > 0 -%}
            {%- assign panel_id = 'kk-mega-' | append: section.id | append: '-' | append: forloop.index -%}
            <li class="kk-nav__item kk-nav__item--has">
              <a href="{{ link.url }}" class="kk-nav__link kk-header__link"{% if link.active %} aria-current="page"{% elsif link.child_active %} data-child-active="true"{% endif %}>{{ link.title | escape }}</a>
              <button type="button" class="kk-nav__toggle" aria-expanded="false" aria-controls="{{ panel_id }}" aria-label="Open {{ link.title | escape }} menu" data-mega-toggle>
                <svg class="kk-nav__chev" width="11" height="7" viewBox="0 0 11 7" aria-hidden="true" focusable="false"><path d="M1 1l4.5 4.5L10 1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>

              <div class="kk-mega" id="{{ panel_id }}" data-mega>
                <div class="kk-wrap kk-mega__inner">
                  <ul class="kk-mega__cols">
                    {%- for child in link.links -%}
                      <li class="kk-mega__col">
                        {%- if child.links.size > 0 -%}
                          <a href="{{ child.url }}" class="kk-mega__heading">{{ child.title | escape }}</a>
                          <ul class="kk-mega__list">
                            {%- for grandchild in child.links -%}
                              <li><a href="{{ grandchild.url }}" class="kk-mega__link">{{ grandchild.title | escape }}</a></li>
                            {%- endfor -%}
                          </ul>
                        {%- else -%}
                          <a href="{{ child.url }}" class="kk-mega__link kk-mega__link--lead">{{ child.title | escape }}</a>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}

                    {%- for block in section.blocks -%}
                      {%- if block.type == 'promo' and block.settings.menu_item != blank and block.settings.menu_item == link.title -%}
                        <li class="kk-mega__promo" {{ block.shopify_attributes }}>
                          <a class="kk-mega__promo-card" href="{{ block.settings.link | default: link.url }}">
                            {%- if block.settings.image != blank -%}
                              {{ block.settings.image | image_url: width: 520 | image_tag:
                                 widths: '260, 400, 520', sizes: '260px', loading: 'lazy',
                                 class: 'kk-mega__promo-img', alt: block.settings.heading | default: link.title }}
                            {%- endif -%}
                            <span class="kk-mega__promo-body">
                              {%- if block.settings.tag != blank -%}<span class="kk-mega__promo-tag">{{ block.settings.tag | escape }}</span>{%- endif -%}
                              {%- if block.settings.heading != blank -%}<span class="kk-mega__promo-title">{{ block.settings.heading | escape }}</span>{%- endif -%}
                              {%- if block.settings.text != blank -%}<span class="kk-mega__promo-text">{{ block.settings.text | escape }}</span>{%- endif -%}
                              {%- if block.settings.cta != blank -%}<span class="kk-mega__promo-cta">{{ block.settings.cta | escape }} <span aria-hidden="true">→</span></span>{%- endif -%}
                            </span>
                          </a>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            </li>
          {%- else -%}
            <li class="kk-nav__item">
              <a href="{{ link.url }}" class="kk-nav__link kk-header__link"{% if link.active %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    <div class="kk-header__actions">
      {%- if section.settings.enable_search -%}
        <button class="kk-header__icon" data-search-toggle aria-expanded="false" aria-controls="kk-search-{{ section.id }}" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      {%- endif -%}

      {%- if section.settings.enable_account and shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="kk-header__icon kk-header__icon--account" aria-label="Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2"/><path d="M4 21c0-4.2 3.6-7 8-7s8 2.8 8 7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </a>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url }}" class="kk-btn kk-btn--primary kk-header__cta">{{ section.settings.cta_label }}</a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="kk-header__cart" data-cart-toggle aria-label="Open cart">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M6 7h12l-1 13H7L6 7z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 7V5a3 3 0 016 0v2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="kk-header__count" data-cart-count>{{ cart.item_count }}</span>
      </a>

      <button class="kk-header__burger" data-nav-toggle aria-label="Open menu" aria-expanded="false" aria-controls="kk-mobile-{{ section.id }}"><span></span><span></span><span></span></button>
    </div>
  </div>

  {%- if section.settings.enable_search -%}
    <div class="kk-search" id="kk-search-{{ section.id }}" data-search-panel hidden>
      <div class="kk-wrap kk-search__inner">
        <form action="{{ routes.search_url }}" method="get" role="search" class="kk-search__form" data-search-form>
          <input type="hidden" name="type" value="product">
          <span class="kk-search__ico" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </span>
          <input type="search" name="q" class="kk-search__input" placeholder="Search gear, e.g. 2-in-1 shorts…" autocomplete="off" aria-label="Search the store" data-search-input>
          <button type="submit" class="kk-btn kk-btn--primary kk-search__submit">Search</button>
          <button type="button" class="kk-search__close" data-search-close aria-label="Close search">&times;</button>
        </form>
        <div class="kk-search__results" data-search-results aria-live="polite"></div>
      </div>
    </div>
  {%- endif -%}

  <div class="kk-header__mobile" id="kk-mobile-{{ section.id }}" data-mobile-nav hidden>
    <ul class="kk-mnav">
      {%- for link in section.settings.menu.links -%}
        <li class="kk-mnav__item">
          {%- if link.links.size > 0 -%}
            {%- assign msub_id = 'kk-msub-' | append: section.id | append: '-' | append: forloop.index -%}
            <div class="kk-mnav__row">
              <a href="{{ link.url }}" class="kk-mnav__link">{{ link.title | escape }}</a>
              <button type="button" class="kk-mnav__toggle" aria-expanded="false" aria-controls="{{ msub_id }}" aria-label="Expand {{ link.title | escape }}" data-msub-toggle>
                <svg class="kk-nav__chev" width="12" height="8" viewBox="0 0 11 7" aria-hidden="true" focusable="false"><path d="M1 1l4.5 4.5L10 1" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
            <div class="kk-mnav__sub" id="{{ msub_id }}" hidden>
              {%- for child in link.links -%}
                {%- if child.links.size > 0 -%}
                  <span class="kk-mnav__group"><a href="{{ child.url }}">{{ child.title | escape }}</a></span>
                  {%- for grandchild in child.links -%}
                    <a href="{{ grandchild.url }}" class="kk-mnav__sublink">{{ grandchild.title | escape }}</a>
                  {%- endfor -%}
                {%- else -%}
                  <a href="{{ child.url }}" class="kk-mnav__sublink">{{ child.title | escape }}</a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- else -%}
            <a href="{{ link.url }}" class="kk-mnav__link">{{ link.title | escape }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
      {%- if section.settings.enable_account and shop.customer_accounts_enabled -%}
        <li class="kk-mnav__item">
          <a href="{{ routes.account_url }}" class="kk-mnav__link">My Account</a>
        </li>
      {%- endif -%}
    </ul>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu",
      "info": "Nested menu items (up to 3 levels) render automatically as a mega menu on desktop and an accordion on mobile." },
    { "type": "text", "id": "cta_label", "label": "Header button", "default": "Shop Now" },
    { "type": "url", "id": "cta_url", "label": "Header button link" },
    { "type": "header", "content": "Search & account" },
    { "type": "checkbox", "id": "enable_search", "label": "Enable predictive search", "default": true },
    { "type": "checkbox", "id": "enable_account", "label": "Show account link", "default": true,
      "info": "Only appears when customer accounts are enabled in Settings → Customer accounts." }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Mega menu promo",
      "limit": 6,
      "settings": [
        { "type": "paragraph", "content": "Adds a featured card inside a mega menu panel." },
        { "type": "text", "id": "menu_item", "label": "Attach to top-level menu item",
          "info": "Type the exact title of the top-level menu item whose panel should show this promo (e.g. Shop)." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "New Drop" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Collection" },
        { "type": "text", "id": "text", "label": "Text", "default": "Shop the latest fighter-built gear." },
        { "type": "text", "id": "cta", "label": "Call to action", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
