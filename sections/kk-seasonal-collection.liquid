{%- liquid
  assign hero_image = section.settings.hero_image | default: collection.image
  assign hero_alt = section.settings.hero_image_alt | default: hero_image.alt | default: section.settings.heading
  assign hero_body = section.settings.body
  if hero_body == blank
    assign hero_body = collection.description
  endif
-%}

<section class="kk-seasonal" aria-labelledby="SeasonalHeading-{{ section.id }}">
  <div class="kk-seasonal__hero">
    <div class="kk-seasonal__media" aria-hidden="true">
      {% render 'responsive-image',
        image: hero_image,
        sizes: '100vw',
        widths: '640, 960, 1280, 1600, 1920, 2400',
        preload: true,
        class: 'kk-seasonal__hero-image',
        alt: hero_alt
      %}
      <span class="kk-seasonal__scrim"></span>
      <span class="kk-seasonal__ghost">{{ section.settings.ghost_word }}</span>
    </div>

    <div class="kk-wrap kk-seasonal__hero-inner">
      <div class="kk-seasonal__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="kk-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h1 class="kk-seasonal__heading" id="SeasonalHeading-{{ section.id }}">{{ section.settings.heading | default: collection.title }}</h1>
        {%- if hero_body != blank -%}
          <div class="kk-seasonal__body rte">{{ hero_body }}</div>
        {%- endif -%}
        <div class="kk-seasonal__actions">
          {%- if section.settings.primary_label != blank -%}
            <a class="kk-btn kk-btn--primary" href="#SeasonalProducts">{{ section.settings.primary_label }}</a>
          {%- endif -%}
          {%- if section.settings.secondary_label != blank and section.settings.secondary_url != blank -%}
            <a class="kk-btn kk-btn--ghost" href="{{ section.settings.secondary_url }}">{{ section.settings.secondary_label }}</a>
          {%- endif -%}
        </div>

        {%- if section.settings.show_palette -%}
          <div class="kk-seasonal__palette" aria-label="{{ 'seasonal.palette_label' | t }}">
            <span style="--swatch:#000000"><i aria-hidden="true"></i>{{ 'seasonal.black' | t }}</span>
            <span style="--swatch:#262626"><i aria-hidden="true"></i>{{ 'seasonal.charcoal' | t }}</span>
            <span style="--swatch:#c81010"><i aria-hidden="true"></i>{{ 'seasonal.red' | t }}</span>
            <span style="--swatch:#ede8dc"><i aria-hidden="true"></i>{{ 'seasonal.bone' | t }}</span>
            <span style="--swatch:#d4af37"><i aria-hidden="true"></i>{{ 'seasonal.gold' | t }}</span>
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.release_note != blank -%}
        <p class="kk-seasonal__release">{{ section.settings.release_note }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="kk-seasonal__capsules kk-wrap" aria-label="{{ 'seasonal.capsules_label' | t }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign capsule_collection = block.settings.collection
          assign capsule_image = block.settings.image | default: capsule_collection.image
          assign capsule_title = block.settings.title | default: capsule_collection.title
          assign capsule_url = capsule_collection.url | default: '#SeasonalProducts'
          assign capsule_alt = block.settings.image_alt | default: capsule_image.alt | default: capsule_title
        -%}
        <article class="kk-seasonal-card" style="--capsule-accent:{{ block.settings.accent }}" {{ block.shopify_attributes }}>
          <div class="kk-seasonal-card__media">
            {% render 'responsive-image',
              image: capsule_image,
              sizes: '(max-width: 760px) 100vw, 33vw',
              widths: '360, 540, 720, 900',
              class: 'kk-seasonal-card__image',
              alt: capsule_alt
            %}
            <span class="kk-seasonal-card__shade"></span>
          </div>
          <div class="kk-seasonal-card__content">
            {%- if block.settings.eyebrow != blank -%}<p>{{ block.settings.eyebrow }}</p>{%- endif -%}
            <h2>{{ capsule_title }}</h2>
            {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <a href="{{ capsule_url }}">{{ block.settings.link_label }} <span aria-hidden="true">→</span></a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .kk-seasonal{overflow:hidden;background:#070707;border-bottom:1px solid rgba(255,255,255,.08)}
  .kk-seasonal__hero{position:relative;min-height:min(820px,88vh);display:flex;align-items:flex-end;isolation:isolate}
  .kk-seasonal__media{position:absolute;inset:0;z-index:-1;background:radial-gradient(circle at 75% 30%,#381014 0%,#111 42%,#070707 76%)}
  .kk-seasonal__hero-image,.kk-seasonal__media .kk-img-ph{width:100%;height:100%;object-fit:cover;object-position:center}
  .kk-seasonal__scrim{position:absolute;inset:0;background:linear-gradient(90deg,rgba(7,7,7,.98) 0%,rgba(7,7,7,.9) 37%,rgba(7,7,7,.38) 72%),linear-gradient(0deg,rgba(7,7,7,.96),transparent 56%)}
  .kk-seasonal__ghost{position:absolute;right:-.035em;bottom:-.12em;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.085);font-family:var(--display);font-size:clamp(5rem,17vw,16rem);font-weight:900;line-height:.78;letter-spacing:-.06em;text-transform:uppercase;white-space:nowrap;user-select:none}
  .kk-seasonal__hero-inner{display:flex;align-items:flex-end;justify-content:space-between;gap:48px;padding-top:clamp(130px,18vw,230px);padding-bottom:clamp(70px,9vw,116px)}
  .kk-seasonal__copy{max-width:800px}
  .kk-seasonal__heading{max-width:10ch;margin:0 0 24px;font-family:var(--display);font-size:clamp(3.5rem,9vw,8rem);font-weight:900;line-height:.82;letter-spacing:-.055em;text-transform:uppercase;text-wrap:balance}
  .kk-seasonal__body{max-width:57ch;color:#d4d4d8;font-size:clamp(1rem,1.55vw,1.2rem);line-height:1.7}
  .kk-seasonal__actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
  .kk-seasonal__palette{display:flex;flex-wrap:wrap;gap:10px 18px;margin-top:34px;color:#b7b7be;font-family:var(--display);font-size:.58rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .kk-seasonal__palette span{display:inline-flex;align-items:center;gap:8px}
  .kk-seasonal__palette i{width:18px;height:18px;border:1px solid rgba(255,255,255,.26);border-radius:50%;background:var(--swatch);box-shadow:0 0 0 2px rgba(0,0,0,.28)}
  .kk-seasonal__release{max-width:190px;margin:0 0 4px;padding:16px 0 16px 18px;border-left:2px solid var(--gold);color:#d4d4d8;font-family:var(--display);font-size:.65rem;font-weight:800;line-height:1.55;letter-spacing:.15em;text-transform:uppercase}
  .kk-seasonal__capsules{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;padding-top:28px;padding-bottom:28px}
  .kk-seasonal-card{position:relative;min-height:460px;overflow:hidden;border:1px solid rgba(255,255,255,.12);border-radius:16px;background:#111;isolation:isolate}
  .kk-seasonal-card::after{content:"";position:absolute;inset:auto 0 0;height:3px;background:var(--capsule-accent)}
  .kk-seasonal-card__media{position:absolute;inset:0;z-index:-1}
  .kk-seasonal-card__image,.kk-seasonal-card__media .kk-img-ph{width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.7,.2,1)}
  .kk-seasonal-card:hover .kk-seasonal-card__image{transform:scale(1.035)}
  .kk-seasonal-card__shade{position:absolute;inset:0;background:linear-gradient(0deg,rgba(7,7,7,.98) 0%,rgba(7,7,7,.76) 42%,rgba(7,7,7,.12) 76%)}
  .kk-seasonal-card__content{position:absolute;inset:auto 0 0;padding:30px}
  .kk-seasonal-card__content>p{margin:0 0 9px;color:var(--capsule-accent);font-family:var(--display);font-size:.62rem;font-weight:900;letter-spacing:.18em;text-transform:uppercase}
  .kk-seasonal-card h2{margin:0 0 12px;font-family:var(--display);font-size:clamp(1.7rem,3vw,2.5rem);font-weight:900;line-height:.95;text-transform:uppercase}
  .kk-seasonal-card .rte{max-width:38ch;color:#c3c3c9;font-size:.9rem;line-height:1.58}
  .kk-seasonal-card a{display:inline-flex;align-items:center;gap:8px;margin-top:20px;color:#fff;font-family:var(--display);font-size:.72rem;font-weight:900;letter-spacing:.12em;text-decoration:none;text-transform:uppercase}
  .kk-seasonal-card a:hover{color:var(--capsule-accent)}
  @media (max-width:900px){.kk-seasonal__hero-inner{align-items:flex-start;flex-direction:column}.kk-seasonal__release{max-width:360px}.kk-seasonal__capsules{grid-template-columns:1fr 1fr}.kk-seasonal-card:first-child{grid-column:1/-1}}
  @media (max-width:640px){.kk-seasonal__hero{min-height:760px}.kk-seasonal__scrim{background:linear-gradient(0deg,rgba(7,7,7,.98) 8%,rgba(7,7,7,.84) 60%,rgba(7,7,7,.35))}.kk-seasonal__hero-inner{padding-top:190px;padding-bottom:54px;gap:24px}.kk-seasonal__heading{font-size:clamp(3.2rem,17vw,5rem)}.kk-seasonal__palette{display:grid;grid-template-columns:1fr 1fr}.kk-seasonal__capsules{grid-template-columns:1fr}.kk-seasonal-card:first-child{grid-column:auto}.kk-seasonal-card{min-height:420px}.kk-seasonal-card__content{padding:24px}}
  @media (prefers-reduced-motion:reduce){.kk-seasonal-card__image{transition:none}}
{% endstylesheet %}

{% schema %}
{
  "name": "t:seasonal.collection_name",
  "tag": "section",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "t:seasonal.hero_image" },
    { "type": "text", "id": "hero_image_alt", "label": "t:seasonal.image_alt" },
    { "type": "text", "id": "eyebrow", "label": "t:seasonal.eyebrow", "default": "Fall / Winter 2026 · Limited Drop" },
    { "type": "text", "id": "heading", "label": "t:seasonal.heading", "default": "Cold Camps. Hard Rounds." },
    { "type": "richtext", "id": "body", "label": "t:seasonal.body", "default": "<p>Performance layers and heavyweight staples built for the gym, the street and every cold round between.</p>" },
    { "type": "text", "id": "ghost_word", "label": "t:seasonal.background_word", "default": "FALL / WINTER" },
    { "type": "text", "id": "primary_label", "label": "t:seasonal.primary_button", "default": "Shop the Drop" },
    { "type": "text", "id": "secondary_label", "label": "t:seasonal.secondary_button", "default": "Get Drop Alerts" },
    { "type": "url", "id": "secondary_url", "label": "t:seasonal.secondary_link" },
    { "type": "text", "id": "release_note", "label": "t:seasonal.release_note", "default": "Fighter owned · Performance driven · Limited seasonal run" },
    { "type": "checkbox", "id": "show_palette", "label": "t:seasonal.show_palette", "default": true }
  ],
  "blocks": [
    {
      "type": "capsule",
      "name": "t:seasonal.capsule_name",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:seasonal.collection" },
        { "type": "image_picker", "id": "image", "label": "t:seasonal.capsule_image" },
        { "type": "text", "id": "image_alt", "label": "t:seasonal.image_alt" },
        { "type": "text", "id": "eyebrow", "label": "t:seasonal.eyebrow", "default": "Capsule 01" },
        { "type": "text", "id": "title", "label": "t:seasonal.title", "default": "Core Performance" },
        { "type": "richtext", "id": "text", "label": "t:seasonal.body", "default": "<p>Technical layers, tonal marks and disciplined details for daily training.</p>" },
        { "type": "text", "id": "link_label", "label": "t:seasonal.link_label", "default": "Explore the capsule" },
        { "type": "color", "id": "accent", "label": "t:seasonal.accent", "default": "#c81010" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "t:seasonal.collection_name",
      "blocks": [
        { "type": "capsule" },
        { "type": "capsule", "settings": { "eyebrow": "Women's capsule", "title": "Pretty Dangerous", "accent": "#c81010" } },
        { "type": "capsule", "settings": { "eyebrow": "Men's + unisex capsule", "title": "No Crown Given", "accent": "#d4af37" } }
      ]
    }
  ]
}
{% endschema %}
