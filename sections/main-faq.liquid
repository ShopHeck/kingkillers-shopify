{%- comment -%}
  Dedicated FAQ hub. All answers are server-rendered, searchable as a progressive
  enhancement, and emitted from the same source as the FAQPage graph.
{%- endcomment -%}
{%- assign faq_categories = 'orders|shipping|returns|sizing|products|care|brand' | split: '|' -%}

<section class="kk-faq-page" data-faq-hub aria-labelledby="faq-page-{{ section.id }}">
  <header class="kk-faq-page__hero">
    <div class="kk-wrap">
      <nav class="kk-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><span aria-current="page">{{ page.title }}</span>
      </nav>
      <div class="kk-faq-page__hero-grid">
        <div class="kk-faq-page__intro">
          {%- if section.settings.eyebrow != blank -%}<p class="kk-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h1 id="faq-page-{{ section.id }}">{{ section.settings.heading | default: page.title }}</h1>
          {%- if section.settings.intro != blank -%}<div class="kk-faq-page__lead rte">{{ section.settings.intro }}</div>{%- endif -%}
        </div>
        <div class="kk-faq-page__search-card">
          <label for="faq-search-{{ section.id }}">Search all questions</label>
          <div class="kk-faq-page__search-wrap">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
            <input id="faq-search-{{ section.id }}" type="search" inputmode="search" autocomplete="off" placeholder="Try shipping or returns" data-faq-search aria-describedby="faq-search-help-{{ section.id }}">
          </div>
          <p id="faq-search-help-{{ section.id }}">Results update as you type. Every answer remains available without JavaScript.</p>
          <p class="kk-faq-page__status" data-faq-status aria-live="polite"></p>
        </div>
      </div>

      <nav class="kk-faq-page__topics" aria-label="FAQ topics">
        {%- for category in faq_categories -%}
          {%- assign category_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.category == category -%}{%- assign category_count = category_count | plus: 1 -%}{%- endif -%}
          {%- endfor -%}
          {%- if category_count > 0 -%}
            {%- case category -%}
              {%- when 'orders' -%}{%- assign category_label = 'Orders' -%}
              {%- when 'shipping' -%}{%- assign category_label = 'Shipping' -%}
              {%- when 'returns' -%}{%- assign category_label = 'Returns' -%}
              {%- when 'sizing' -%}{%- assign category_label = 'Sizing & fit' -%}
              {%- when 'products' -%}{%- assign category_label = 'Products' -%}
              {%- when 'care' -%}{%- assign category_label = 'Product care' -%}
              {%- when 'brand' -%}{%- assign category_label = 'About the brand' -%}
            {%- endcase -%}
            <a href="#faq-{{ category }}-{{ section.id }}">{{ category_label }}<span>{{ category_count }}</span></a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    </div>
  </header>

  <div class="kk-wrap kk-faq-page__body">
    <div class="kk-faq-page__groups">
      {%- for category in faq_categories -%}
        {%- assign category_count = 0 -%}
        {%- capture category_questions -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.category == category and block.settings.question != blank and block.settings.answer != blank -%}
              {%- assign category_count = category_count | plus: 1 -%}
              <details class="kk-faq-page__item" data-faq-item data-faq-keywords="{{ category }}" {{ block.shopify_attributes }}{% if category == 'orders' and category_count == 1 %} open{% endif %}>
                <summary>
                  <span>{{ block.settings.question }}</span>
                  <span class="kk-faq-page__plus" aria-hidden="true"></span>
                </summary>
                <div class="kk-faq-page__answer rte">{{ block.settings.answer }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if category_count > 0 -%}
          {%- case category -%}
            {%- when 'orders' -%}{%- assign category_label = 'Orders & account' -%}{%- assign category_note = 'From checkout confirmation to order changes.' -%}
            {%- when 'shipping' -%}{%- assign category_label = 'Shipping & delivery' -%}{%- assign category_note = 'Processing, transit times, tracking, and international orders.' -%}
            {%- when 'returns' -%}{%- assign category_label = 'Returns & exchanges' -%}{%- assign category_note = 'Eligibility, exceptions, and how to start a return.' -%}
            {%- when 'sizing' -%}{%- assign category_label = 'Sizing & fit' -%}{%- assign category_note = 'How to choose training gear that fits the way you move.' -%}
            {%- when 'products' -%}{%- assign category_label = 'Products & production' -%}{%- assign category_note = 'What we make, where it is made, and what to expect.' -%}
            {%- when 'care' -%}{%- assign category_label = 'Product care' -%}{%- assign category_note = 'Keep prints, fabrics, and performance gear ready for the next round.' -%}
            {%- when 'brand' -%}{%- assign category_label = 'About King Killers' -%}{%- assign category_note = 'The fighter-owned story and ways to work with us.' -%}
          {%- endcase -%}
          <section id="faq-{{ category }}-{{ section.id }}" class="kk-faq-page__group" data-faq-group>
            <div class="kk-faq-page__group-head">
              <p>Topic</p>
              <h2>{{ category_label }}</h2>
              <span>{{ category_note }}</span>
            </div>
            <div class="kk-faq-page__list">{{ category_questions }}</div>
          </section>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="kk-faq-page__empty" data-faq-empty hidden>
      <strong>No exact match.</strong>
      <p>Try a shorter search or ask the King Killers team directly.</p>
    </div>

    <aside class="kk-faq-page__support" aria-label="Customer support">
      <div>
        <p class="kk-eyebrow">Still in your corner</p>
        <h2>Need a human answer?</h2>
        <p>Send your order number when asking about an existing order so the team can help faster.</p>
      </div>
      <div class="kk-faq-page__support-actions">
        <a class="kk-btn kk-btn--primary" href="{{ section.settings.contact_url | default: '/pages/contact' }}">Contact support</a>
        <a class="kk-btn kk-btn--ghost" href="{{ section.settings.shop_url | default: routes.all_products_collection_url }}">Shop all gear</a>
      </div>
    </aside>
  </div>
</section>

{% render 'structured-data-page-breadcrumb' %}

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "name": {{ page.title | json }},
    "url": {{ shop.url | append: page.url | json }},
    "mainEntity": [
      {%- assign faq_json_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.question != blank and block.settings.answer != blank -%}
          {%- if faq_json_index > 0 -%},{%- endif -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }
          {%- assign faq_json_index = faq_json_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ hub",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer corner" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "King Killers FAQ. No runaround." },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Clear answers about King Killers orders, shipping, returns, sizing, product care, and the fighter-owned brand behind the gear.</p>" },
    { "type": "url", "id": "contact_url", "label": "Contact page" },
    { "type": "url", "id": "shop_url", "label": "Shop link" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Topic",
          "default": "orders",
          "options": [
            { "value": "orders", "label": "Orders" },
            { "value": "shipping", "label": "Shipping" },
            { "value": "returns", "label": "Returns" },
            { "value": "sizing", "label": "Sizing and fit" },
            { "value": "products", "label": "Products" },
            { "value": "care", "label": "Product care" },
            { "value": "brand", "label": "About the brand" }
          ]
        },
        { "type": "text", "id": "question", "label": "Question", "default": "How can we help?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Add a concise, factual answer and link to the relevant policy or product page when useful.</p>" }
      ]
    }
  ],
  "max_blocks": 40,
  "presets": [
    {
      "name": "FAQ hub",
      "blocks": [
        { "type": "question", "settings": { "category": "orders", "question": "How do I know my order went through?", "answer": "<p>Shopify sends an order confirmation to the email or phone number used at checkout. If you do not see it, check your spam folder, then contact us with the name and email used for the order.</p>" } },
        { "type": "question", "settings": { "category": "shipping", "question": "When will my order ship?", "answer": "<p>Most apparel orders process in 1–3 business days. Tracking is sent as soon as the order ships. Current transit estimates and product-specific delays are listed in our <a href=\"/policies/shipping-policy\">shipping policy</a>.</p>" } },
        { "type": "question", "settings": { "category": "returns", "question": "What is the return window?", "answer": "<p>Eligible items may be returned within 30 days after delivery. Items must be unworn, unused, tagged, and in their original packaging. Review all exceptions before sending anything back.</p>" } },
        { "type": "question", "settings": { "category": "sizing", "question": "How should I choose my size?", "answer": "<p>Compare the measurement chart for this product with a similar garment that fits you well. Sizes vary by style; contact us before ordering if you need help.</p>" } },
        { "type": "question", "settings": { "category": "brand", "question": "Who is behind King Killers Apparel?", "answer": "<p>King Killers Apparel was founded in 2021 by professional fighter Michael “Heck” Heckert. The brand is fighter-owned and based in the Tampa Bay area.</p>" } }
      ]
    }
  ]
}
{% endschema %}
