
{%- comment -%}
  Title / description / Open Graph / Twitter card.
  page_title & page_description are populated per-resource by Shopify.
{%- endcomment -%}
{%- liquid
  comment
    entity_decode_fix: stored SEO descriptions can carry pre-escaped entities
    (&quot; / &#39;) from apps or imports. Decode once here so the single
    escape filter below yields exactly-once-escaped meta content.
  endcomment
  assign og_title = page_title | replace: "&quot;", "" | replace: "&#39;", "'" | replace: "&amp;", "&"
  assign og_desc_raw = page_description | default: shop.description | default: settings.brand_description
  assign og_desc = og_desc_raw | replace: "&quot;", "" | replace: "&#39;", "'" | replace: "&amp;", "&"
  if request.page_type == 'index'
    assign og_title = settings.brand_name | default: shop.name | append: ' | Fighter-Owned Combat Sports Apparel'
  endif
-%}
<title>{{ page_title }}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>

{%- if og_desc != blank -%}
  <meta name="description" content="{{ og_desc | strip_html | escape }}">
{%- endif -%}

<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_desc | strip_html | escape }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
<meta property="og:locale" content="{{ request.locale.iso_code }}">
{%- if request.page_type == 'product' and product.featured_media -%}
  <meta property="og:image" content="https:{{ product.featured_media | image_url: width: 1200 }}">
{%- elsif settings.share_image != blank -%}
  <meta property="og:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_desc | strip_html | escape }}">
{%- if settings.twitter_handle != blank -%}
  <meta name="twitter:site" content="{{ settings.twitter_handle }}">
{%- endif -%}
