{%- comment -%}
  Reusable responsive image emitting RAW <img> markup (bypasses image_tag attribute
  handling entirely so class/loading/fetchpriority/alt always survive).

  Sizing: candidate widths are CLAMPED to the source image's real width. Shopify never
  upscales, so asking for a width larger than the original returns the original bytes —
  advertising it as e.g. "2400w" makes the browser mis-pick and download an oversized
  candidate for its slot. We keep every candidate honest, plus one exact-native entry.

  preload:true    -> eager + fetchpriority high + sync decode (LCP element)
  eager_first     -> eager + fetchpriority low (above-fold, but not the LCP)
  (default)       -> lazy + fetchpriority auto

  Usage:
    {% render 'responsive-image', image: section.settings.image, sizes: '100vw', preload: true, class: 'kk-hero__img', alt: '...' %}
{%- endcomment -%}
{%- liquid
  assign img_widths = widths | default: '320, 480, 640, 800, 1080, 1440, 1920, 2400'
  assign img_sizes = sizes | default: '100vw'
  assign is_lcp = preload | default: false
  assign eager_early = eager_first | default: false
  assign img_alt = alt | default: image.alt | default: ''
  assign img_class = class | default: ''

  assign loading_attr = 'lazy'
  assign fetchpriority_attr = 'auto'
  assign decoding_attr = 'async'
  if is_lcp
    assign loading_attr = 'eager'
    assign fetchpriority_attr = 'high'
    assign decoding_attr = 'sync'
  elsif eager_early
    assign loading_attr = 'eager'
    assign fetchpriority_attr = 'low'
  endif

  assign native_w = image.width | default: 0

  if image == blank
    assign native_w = 0
  endif

  comment
    Build the candidate list: every requested width that the source can actually
    deliver, plus the native width itself when the request list overshoots it.
    That keeps a retina candidate available without lying about its size.
  endcomment
  assign kept_widths = ''
  assign sep = ''
  assign largest_kept = 0
  assign overshot = false
  assign width_list = img_widths | split: ','
  for w in width_list
    assign ww = w | strip | times: 1
    if ww <= native_w
      assign kept_widths = kept_widths | append: sep | append: ww
      assign sep = ','
      if ww > largest_kept
        assign largest_kept = ww
      endif
    else
      assign overshot = true
    endif
  endfor
  if overshot and native_w > largest_kept
    assign kept_widths = kept_widths | append: sep | append: native_w
    assign sep = ','
    assign largest_kept = native_w
  endif
  if kept_widths == blank
    assign kept_widths = native_w | append: ''
    assign largest_kept = native_w
  endif

  comment
    Fallback src for no-srcset clients: a mid-weight candidate, never the largest.
  endcomment
  assign main_url = ''
  assign srcset_parts = ''
  if native_w > 0
    assign kept_list = kept_widths | split: ','
    assign mid_index = kept_list.size | minus: 1 | divided_by: 2
    assign fallback_w = kept_list[mid_index] | times: 1

    assign main_url = image | image_url: width: fallback_w
    if main_url contains '//'
      assign main_url = main_url | prepend: 'https:'
    endif

    assign sep = ''
    for w in kept_list
      assign ww = w | times: 1
      assign u_w = image | image_url: width: ww
      if u_w contains '//'
        assign u_w = u_w | prepend: 'https:'
      endif
      assign src_parts = srcset_parts | append: sep | append: u_w | append: ' ' | append: ww | append: 'w'
      assign srcset_parts = src_parts
      assign sep = ', '
    endfor
  endif
-%}
{%- if image != blank and native_w > 0 -%}
  <img
    src="{{ main_url }}"
    srcset="{{ srcset_parts }}"
    sizes="{{ img_sizes }}"
    width="{{ image.width }}"
    height="{{ image.height }}"
    alt="{{ img_alt | escape }}"
    loading="{{ loading_attr }}"
    fetchpriority="{{ fetchpriority_attr }}"
    decoding="{{ decoding_attr }}"
    {% if img_class != blank %}class="{{ img_class }}"{% endif %}>
{%- else -%}
  <div class="kk-img-ph" aria-hidden="true">
    {{ 'product-1' | placeholder_svg_tag: 'kk-img-ph__svg' }}
  </div>
{%- endif -%}
