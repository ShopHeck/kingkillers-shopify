{%- comment -%}
  Reusable responsive image emitting RAW <img> markup (bypasses image_tag attribute
  handling entirely so class/loading/fetchpriority/alt always survive).
  preload:true -> eager + fetchpriority high. eager_first -> eager + fetchpriority low.
  Usage:
    {% render 'responsive-image', image: section.settings.image, sizes: '100vw', preload: true, class: 'kk-hero__img', alt: '...' %}
{%- endcomment -%}
{%- liquid
  assign img_widths = widths | default: '320, 480, 640, 800, 1080, 1440, 1920, 2400'
  assign img_sizes = sizes | default: '100vw'
  assign is_lcp = preload | default: false
  assign eager_early = eager_first | default: false
  assign img_alt = alt | default: image.alt | default: ''
  assign img_class = class | default: ''

  assign loading_attr = 'lazy'
  assign fetchpriority_attr = 'auto'
  if is_lcp
    assign loading_attr = 'eager'
    assign fetchpriority_attr = 'high'
  elsif eager_early
    assign loading_attr = 'eager'
    assign fetchpriority_attr = 'low'
  endif

  assign main_url = image | image_url: width: 2400
  if main_url contains '//'
    assign main_url = main_url | prepend: 'https:'
  endif

  assign srcset_parts = ''
  assign sep = ''
  assign width_list = img_widths | split: ','
  for w in width_list
    assign ww = w | strip
    assign u_w = image | image_url: width: ww
    if u_w contains '//'
      assign u_w = u_w | prepend: 'https:'
    endif
    assign src_parts = srcset_parts | append: sep | append: u_w | append: ' ' | append: ww | append: 'w'
    assign srcset_parts = src_parts
    assign sep = ', '
  endfor
-%}
{%- if image != blank -%}
  <img
    src="{{ main_url }}"
    srcset="{{ srcset_parts }}"
    sizes="{{ img_sizes }}"
    width="{{ image.width }}"
    height="{{ image.height }}"
    alt="{{ img_alt | escape }}"
    loading="{{ loading_attr }}"
    fetchpriority="{{ fetchpriority_attr }}"
    decoding="async"
    {% if img_class != blank %}class="{{ img_class }}"{% endif %}>
{%- else -%}
  <div class="kk-img-ph" aria-hidden="true">
    {{ 'product-1' | placeholder_svg_tag: 'kk-img-ph__svg' }}
  </div>
{%- endif -%}
