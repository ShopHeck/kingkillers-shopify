{%- comment -%}
  Organization + WebSite + Store JSON-LD. SITE-WIDE, so it lives in theme.liquid.
  All NAP/brand facts come from theme settings -> identical in copy AND schema (GEO).
  @id cross-references link the entities for knowledge-graph / AI extraction.
{%- endcomment -%}
{%- liquid
  assign org_id = shop.url | append: '/#organization'
  assign site_id = shop.url | append: '/#website'
  assign store_id = shop.url | append: '/#store'

  comment
    One resolved brand image, reused by Organization.logo and Store.image. Google
    needs a real ImageObject here — the previous fallback emitted the shop URL.
  endcomment
  assign brand_logo = settings.share_image
  if brand_logo == blank
    assign brand_logo = shop.brand.square_logo
  endif
  if brand_logo == blank
    assign brand_logo = shop.brand.logo
  endif
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": {{ org_id | json }},
      "name": {{ settings.brand_name | default: shop.name | json }},
      "url": {{ shop.url | json }},
      "description": {{ settings.brand_description | json }},
      "slogan": {{ settings.brand_slogan | json }},
      "foundingDate": {{ settings.founding_year | json }},
      "founder": { "@type": "Person", "name": {{ settings.founder_name | json }} },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": {{ settings.nap_city | json }},
        "addressRegion": {{ settings.nap_region | json }},
        "postalCode": {{ settings.nap_zip | json }},
        "addressCountry": "US"
      },
      "email": {{ settings.nap_email | json }},
      "telephone": {{ settings.nap_phone | json }},
      "knowsAbout": [
        "combat sports apparel", "MMA clothing", "BJJ rashguards",
        "boxing apparel", "2-in-1 hybrid shorts", "fighter-owned apparel"
      ],
      {%- comment -%}
        Build sameAs from only the profiles the merchant has actually filled in.
        Emitting an empty string for an unset setting produced ["","",""], which is
        invalid and gives search engines nothing to reconcile the entity against.
      {%- endcomment -%}
      {%- assign social_urls = '' -%}
      {%- assign social_sep = '' -%}
      {%- assign social_candidates = settings.social_instagram | append: '|' | append: settings.social_facebook | append: '|' | append: settings.social_trustpilot | append: '|' | append: settings.social_youtube | append: '|' | append: settings.social_tiktok | split: '|' -%}
      {%- for url in social_candidates -%}
        {%- if url != blank -%}
          {%- assign social_urls = social_urls | append: social_sep | append: url -%}
          {%- assign social_sep = '|' -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if social_urls != blank -%}
      "sameAs": [
        {%- assign social_list = social_urls | split: '|' -%}
        {%- for url in social_list -%}
          {{ url | json }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ],
      {%- endif -%}
      {%- if brand_logo != blank -%}
      "logo": {
        "@type": "ImageObject",
        "url": {{ brand_logo | image_url: width: 600 | prepend: 'https:' | json }},
        "width": 600,
        "height": {{ brand_logo.height | times: 600 | divided_by: brand_logo.width }}
      },
      {%- endif -%}
      "areaServed": "US"
    },
    {
      "@type": "WebSite",
      "@id": {{ site_id | json }},
      "url": {{ shop.url | json }},
      "name": {{ shop.name | json }},
      "publisher": { "@id": {{ org_id | json }} },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ shop.url }}{{ routes.search_url }}?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Store",
      "@id": {{ store_id | json }},
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "description": {{ settings.brand_description | json }},
      {%- if brand_logo != blank -%}
      "image": {{ brand_logo | image_url: width: 1200 | prepend: 'https:' | json }},
      {%- endif -%}
      "priceRange": {{ settings.price_range | default: '$19 - $69' | json }},
      "address": {
        "@type": "PostalAddress",
        "addressLocality": {{ settings.nap_city | json }},
        "addressRegion": {{ settings.nap_region | json }},
        "addressCountry": "US"
      }
    }
  ]
}
</script>