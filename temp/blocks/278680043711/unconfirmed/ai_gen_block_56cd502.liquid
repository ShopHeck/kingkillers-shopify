{% doc %}
  @prompt
    Create a mega menu navigation section for the header that displays multi-column dropdown panels on hover. The mega menu should: show top-level nav items in a horizontal bar, reveal a full-width dropdown panel with multiple columns of sub-links when hovering over a parent item, support images or banners per column (optional), match a premium dark/athletic brand aesthetic, be mobile-responsive with a hamburger menu fallback, and pull navigation links from a Shopify link list (main-menu). Include smooth CSS transitions on open/close.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-mega-menu-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.nav_bg_color }};
    position: relative;
    z-index: 1000;
  }

  .ai-mega-menu__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-mega-menu__nav-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: {{ block.settings.nav_height }}px;
  }

  .ai-mega-menu__logo-{{ ai_gen_id }} {
    font-size: {{ block.settings.logo_size }}px;
    font-weight: 700;
    color: {{ block.settings.nav_text_color }};
    text-decoration: none;
    letter-spacing: 0.5px;
  }

  .ai-mega-menu__items-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.item_spacing }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-mega-menu__item-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-mega-menu__link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    color: {{ block.settings.nav_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.link_size }}px;
    font-weight: 500;
    letter-spacing: 0.3px;
    transition: color 0.3s ease;
  }

  .ai-mega-menu__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.nav_hover_color }};
  }

  .ai-mega-menu__arrow-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    transition: transform 0.3s ease;
  }

  .ai-mega-menu__item-{{ ai_gen_id }}:hover .ai-mega-menu__arrow-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-mega-menu__dropdown-{{ ai_gen_id }} {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background-color: {{ block.settings.dropdown_bg_color }};
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    width: 100vw;
    margin-left: calc(-50vw + 50%);
  }

  .ai-mega-menu__item-{{ ai_gen_id }}:hover .ai-mega-menu__dropdown-{{ ai_gen_id }} {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .ai-mega-menu__dropdown-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.dropdown_padding }}px 20px;
  }

  .ai-mega-menu__columns-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_count }}, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-mega-menu__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-mega-menu__column-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.column_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.dropdown_text_color }};
    margin: 0 0 8px 0;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .ai-mega-menu__column-links-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-mega-menu__sublink-{{ ai_gen_id }} {
    color: {{ block.settings.dropdown_link_color }};
    text-decoration: none;
    font-size: {{ block.settings.sublink_size }}px;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .ai-mega-menu__sublink-{{ ai_gen_id }}:hover {
    color: {{ block.settings.dropdown_hover_color }};
    transform: translateX(4px);
  }

  .ai-mega-menu__column-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-mega-menu__column-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-mega-menu__column-image-{{ ai_gen_id }}:hover img {
    transform: scale(1.05);
  }

  .ai-mega-menu__hamburger-{{ ai_gen_id }} {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .ai-mega-menu__hamburger-line-{{ ai_gen_id }} {
    width: 28px;
    height: 3px;
    background-color: {{ block.settings.nav_text_color }};
    transition: all 0.3s ease;
  }

  .ai-mega-menu__hamburger-{{ ai_gen_id }}.active .ai-mega-menu__hamburger-line-{{ ai_gen_id }}:nth-child(1) {
    transform: rotate(45deg) translate(8px, 8px);
  }

  .ai-mega-menu__hamburger-{{ ai_gen_id }}.active .ai-mega-menu__hamburger-line-{{ ai_gen_id }}:nth-child(2) {
    opacity: 0;
  }

  .ai-mega-menu__hamburger-{{ ai_gen_id }}.active .ai-mega-menu__hamburger-line-{{ ai_gen_id }}:nth-child(3) {
    transform: rotate(-45deg) translate(8px, -8px);
  }

  .ai-mega-menu__mobile-menu-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    top: {{ block.settings.nav_height }}px;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: {{ block.settings.mobile_bg_color }};
    overflow-y: auto;
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ai-mega-menu__mobile-menu-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-mega-menu__mobile-items-{{ ai_gen_id }} {
    list-style: none;
    margin: 0;
    padding: 20px;
  }

  .ai-mega-menu__mobile-item-{{ ai_gen_id }} {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .ai-mega-menu__mobile-link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    color: {{ block.settings.mobile_text_color }};
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
  }

  .ai-mega-menu__mobile-arrow-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    transition: transform 0.3s ease;
  }

  .ai-mega-menu__mobile-item-{{ ai_gen_id }}.expanded .ai-mega-menu__mobile-arrow-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-mega-menu__mobile-submenu-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-mega-menu__mobile-item-{{ ai_gen_id }}.expanded .ai-mega-menu__mobile-submenu-{{ ai_gen_id }} {
    max-height: 1000px;
  }

  .ai-mega-menu__mobile-sublink-{{ ai_gen_id }} {
    display: block;
    padding: 12px 0 12px 20px;
    color: {{ block.settings.mobile_sublink_color }};
    text-decoration: none;
    font-size: 14px;
  }

  @media screen and (max-width: 990px) {
    .ai-mega-menu__items-{{ ai_gen_id }} {
      display: none;
    }

    .ai-mega-menu__hamburger-{{ ai_gen_id }} {
      display: flex;
    }

    .ai-mega-menu__mobile-menu-{{ ai_gen_id }} {
      display: block;
    }
  }
{% endstyle %}

<ai-mega-menu-{{ ai_gen_id }} class="ai-mega-menu-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-mega-menu__container-{{ ai_gen_id }}">
    <nav class="ai-mega-menu__nav-{{ ai_gen_id }}">
      <a href="/" class="ai-mega-menu__logo-{{ ai_gen_id }}">
        {{ block.settings.logo_text }}
      </a>

      <ul class="ai-mega-menu__items-{{ ai_gen_id }}">
        {% for link in linklists[block.settings.menu].links %}
          <li class="ai-mega-menu__item-{{ ai_gen_id }}">
            <a href="{{ link.url }}" class="ai-mega-menu__link-{{ ai_gen_id }}">
              {{ link.title }}
              {% if link.links.size > 0 %}
                <svg class="ai-mega-menu__arrow-{{ ai_gen_id }}" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="2,4 6,8 10,4"></polyline>
                </svg>
              {% endif %}
            </a>

            {% if link.links.size > 0 %}
              <div class="ai-mega-menu__dropdown-{{ ai_gen_id }}">
                <div class="ai-mega-menu__dropdown-container-{{ ai_gen_id }}">
                  <div class="ai-mega-menu__columns-{{ ai_gen_id }}">
                    {% assign links_per_column = link.links.size | divided_by: block.settings.columns_count | plus: 1 %}
                    {% for i in (1..block.settings.columns_count) %}
                      {% assign start_index = forloop.index0 | times: links_per_column %}
                      {% assign end_index = start_index | plus: links_per_column | minus: 1 %}
                      
                      <div class="ai-mega-menu__column-{{ ai_gen_id }}">
                        {% if forloop.first and block.settings.show_column_image and block.settings.column_image %}
                          <div class="ai-mega-menu__column-image-{{ ai_gen_id }}">
                            <img
                              src="{{ block.settings.column_image | image_url: width: 400 }}"
                              alt="{{ block.settings.column_image.alt | escape }}"
                              loading="lazy"
                              width="400"
                              height="300"
                            >
                          </div>
                        {% endif %}

                        <ul class="ai-mega-menu__column-links-{{ ai_gen_id }}">
                          {% for sublink in link.links limit: links_per_column offset: start_index %}
                            <li>
                              <a href="{{ sublink.url }}" class="ai-mega-menu__sublink-{{ ai_gen_id }}">
                                {{ sublink.title }}
                              </a>
                            </li>
                          {% endfor %}
                        </ul>
                      </div>
                    {% endfor %}
                  </div>
                </div>
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>

      <button class="ai-mega-menu__hamburger-{{ ai_gen_id }}" aria-label="Toggle menu" aria-expanded="false">
        <span class="ai-mega-menu__hamburger-line-{{ ai_gen_id }}"></span>
        <span class="ai-mega-menu__hamburger-line-{{ ai_gen_id }}"></span>
        <span class="ai-mega-menu__hamburger-line-{{ ai_gen_id }}"></span>
      </button>
    </nav>
  </div>

  <div class="ai-mega-menu__mobile-menu-{{ ai_gen_id }}">
    <ul class="ai-mega-menu__mobile-items-{{ ai_gen_id }}">
      {% for link in linklists[block.settings.menu].links %}
        <li class="ai-mega-menu__mobile-item-{{ ai_gen_id }}" data-has-children="{% if link.links.size > 0 %}true{% else %}false{% endif %}">
          {% if link.links.size > 0 %}
            <button class="ai-mega-menu__mobile-link-{{ ai_gen_id }}" aria-expanded="false">
              {{ link.title }}
              <svg class="ai-mega-menu__mobile-arrow-{{ ai_gen_id }}" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="2,4 6,8 10,4"></polyline>
              </svg>
            </button>
            <div class="ai-mega-menu__mobile-submenu-{{ ai_gen_id }}">
              {% for sublink in link.links %}
                <a href="{{ sublink.url }}" class="ai-mega-menu__mobile-sublink-{{ ai_gen_id }}">
                  {{ sublink.title }}
                </a>
              {% endfor %}
            </div>
          {% else %}
            <a href="{{ link.url }}" class="ai-mega-menu__mobile-link-{{ ai_gen_id }}">
              {{ link.title }}
            </a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</ai-mega-menu-{{ ai_gen_id }}>

<script>
  (function() {
    class AiMegaMenu{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.hamburger = this.querySelector('.ai-mega-menu__hamburger-{{ ai_gen_id }}');
        this.mobileMenu = this.querySelector('.ai-mega-menu__mobile-menu-{{ ai_gen_id }}');
        this.mobileItems = this.querySelectorAll('.ai-mega-menu__mobile-item-{{ ai_gen_id }}');
        
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.hamburger.addEventListener('click', () => this.toggleMobileMenu());
        
        this.mobileItems.forEach(item => {
          const hasChildren = item.getAttribute('data-has-children') === 'true';
          if (hasChildren) {
            const button = item.querySelector('.ai-mega-menu__mobile-link-{{ ai_gen_id }}');
            button.addEventListener('click', () => this.toggleSubmenu(item, button));
          }
        });
      }

      toggleMobileMenu() {
        const isActive = this.hamburger.classList.toggle('active');
        this.mobileMenu.classList.toggle('active');
        this.hamburger.setAttribute('aria-expanded', isActive);
        
        if (isActive) {
          document.body.style.overflow = 'hidden';
        } else {
          document.body.style.overflow = '';
        }
      }

      toggleSubmenu(item, button) {
        const isExpanded = item.classList.toggle('expanded');
        button.setAttribute('aria-expanded', isExpanded);
      }
    }

    customElements.define('ai-mega-menu-{{ ai_gen_id }}', AiMegaMenu{{ ai_gen_id }});
  })();
</script>

{% schema %}
