{%- comment -%}
  PDP fit, fabric, features and care — driven entirely by product metafields so the
  block is identical across the line and a merchant fills it in once per product.

  Reads:
    custom.features     (list.single_line_text_field)
    custom.fit_note     (single_line_text_field)
    custom.model_stats  (single_line_text_field)
    custom.fabric       (multi_line_text_field)
    custom.care         (multi_line_text_field)
    custom.size_chart_key -> rendered via the size-chart snippet

  Renders nothing at all if the product has none of these, so it is safe to leave in
  the template for every product type.
{%- endcomment -%}
{%- liquid
  assign mf = product.metafields.custom
  assign has_any = false
  if mf.features != blank or mf.fit_note != blank or mf.fabric != blank or mf.care != blank or mf.model_stats != blank
    assign has_any = true
  endif
-%}
{%- if has_any -%}
<section class="kk-section kk-fitfab" aria-labelledby="fitfab-title">
  <div class="kk-wrap">
    <h2 id="fitfab-title" class="kk-h2">{{ section.settings.heading | default: 'Fit &amp; Fabric' }}</h2>

    <div class="kk-fitfab__grid">
      {%- if mf.features != blank -%}
        <div class="kk-fitfab__col">
          <h3 class="kk-fitfab__h">Built with</h3>
          <ul class="kk-fitfab__list">
            {%- for feature in mf.features.value -%}
              <li>{{ feature }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if mf.fit_note != blank or mf.model_stats != blank -%}
        <div class="kk-fitfab__col">
          <h3 class="kk-fitfab__h">Fit</h3>
          {%- if mf.fit_note != blank -%}
            <p class="kk-fitfab__fit">{{ mf.fit_note.value }}</p>
          {%- endif -%}
          {%- if mf.model_stats != blank -%}
            <p class="kk-fitfab__model">{{ mf.model_stats.value }}</p>
          {%- endif -%}
          {%- if section.settings.fit_help != blank -%}
            <div class="rte kk-fitfab__note">{{ section.settings.fit_help }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if mf.fabric != blank or mf.care != blank -%}
        <div class="kk-fitfab__col">
          {%- if mf.fabric != blank -%}
            <h3 class="kk-fitfab__h">Fabric</h3>
            <p class="kk-fitfab__body">{{ mf.fabric.value | newline_to_br }}</p>
          {%- endif -%}
          {%- if mf.care != blank -%}
            <h3 class="kk-fitfab__h kk-fitfab__h--sub">Care</h3>
            <p class="kk-fitfab__body">{{ mf.care.value | newline_to_br }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_size_chart -%}
      {% render 'size-chart', product: product %}
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Fit & fabric",
  "tag": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fit & Fabric" },
    { "type": "checkbox", "id": "show_size_chart", "label": "Show size chart", "default": true },
    { "type": "richtext", "id": "fit_help", "label": "Extra fit guidance", "default": "<p>Every measurement on our size chart is a body measurement, not a garment measurement. Measure over a sports bra with the tape snug and level.</p>" }
  ],
  "presets": [{ "name": "Fit & fabric" }]
}
{% endschema %}
