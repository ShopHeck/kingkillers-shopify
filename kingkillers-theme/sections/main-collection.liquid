{%- comment -%} PLP grid using the shared product-card snippet + paginated, filterable results. {%- endcomment -%}
<section class="kk-section kk-plp" aria-labelledby="plp-title">
  <div class="kk-wrap">
    <header class="kk-plp__head">
      <h1 id="plp-title" class="kk-h2">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="kk-plp__desc rte">{{ collection.description }}</div>{%- endif -%}
    </header>

    {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
      <form class="kk-plp__tools" method="get" aria-label="Collection filters">
        {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
          <div class="kk-plp__filters">
            {%- for filter in collection.filters -%}
              <details class="kk-plp__filter">
                <summary>{{ filter.label }}{% if filter.active_values.size > 0 %} <span>({{ filter.active_values.size }})</span>{% endif %}</summary>
                <div class="kk-plp__filter-body">
                  {%- case filter.type -%}
                    {%- when 'price_range' -%}
                      <label>Min <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" placeholder="0" min="0"></label>
                      <label>Max <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}" min="0"></label>
                    {%- else -%}
                      {%- for value in filter.values -%}
                        <label class="kk-plp__check{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                          <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                          <span>{{ value.label }}</span>
                          <small>{{ value.count }}</small>
                        </label>
                      {%- endfor -%}
                  {%- endcase -%}
                </div>
              </details>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.enable_sorting -%}
          <label class="kk-plp__sort">Sort
            <select name="sort_by" aria-label="Sort products">
              {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
              {%- endfor -%}
            </select>
          </label>
        {%- endif -%}

        <button type="submit" class="kk-btn kk-btn--primary kk-plp__apply">Apply</button>
        {%- if collection.current_vendor or collection.current_type -%}<input type="hidden" name="q" value="{{ collection.current_vendor | default: collection.current_type }}">{%- endif -%}
      </form>

      {%- if collection.filters.size > 0 -%}
        <div class="kk-plp__active" aria-label="Active filters">
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <a href="{{ value.url_to_remove }}">{{ value.label }} ×</a>
            {%- endfor -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
                <a href="{{ filter.url_to_remove }}">Price ×</a>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if collection.filters.size > 0 -%}<a href="{{ collection.url }}" class="kk-plp__clear">Clear all</a>{%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- paginate collection.products by 24 -%}
      <div class="kk-best__grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          <div class="kk-plp__empty">
            <h2>No products found</h2>
            <p>Try removing a filter or head back to the full collection.</p>
            <a href="{{ collection.url }}" class="kk-btn kk-btn--primary">Reset filters</a>
          </div>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="kk-plp__pager" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% render 'structured-data-breadcrumb', collection: collection %}

{% schema %}
{
  "name": "Collection grid",
  "tag": "section",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    { "type": "checkbox", "id": "enable_filtering", "label": "Enable filtering", "default": true },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true }
  ]
}
{% endschema %}
