
<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ settings.theme_color | default: '#070707' }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- comment -%} Flip no-js -> js immediately so we never block paint. {%- endcomment -%}
    <script>document.documentElement.className = document.documentElement.className.replace('no-js','js');</script>

    {%- comment -%} Same-origin CDN for images/fonts — connect early. {%- endcomment -%}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.shopify.com">

    {%- if settings.enable_google_font -%}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;800;900&family=Inter:wght@400;500;600;700&display=swap">
    {%- endif -%}

    {%- comment -%}
      meta-tags  -> <title>, description, Open Graph, Twitter.
      structured-data-org -> Organization + WebSite + Store JSON-LD (SITE-WIDE only).
      Page-specific schema (Product / Breadcrumb / FAQ) is emitted by its own section.
    {%- endcomment -%}
    {% render 'meta-tags' %}
    {% render 'structured-data-org' %}

    {{ 'kk-theme.css' | asset_url | stylesheet_tag }}

    {%- comment -%} Required by Shopify — scripts, analytics, app blocks, checkout helpers. Never remove. {%- endcomment -%}
    {{ content_for_header }}
  </head>

  <body class="kk template-{{ request.page_type | handle }}">
    <a class="kk-skip" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {%- comment -%} Header group = announcement bar + header, editable/reorderable in the editor. {%- endcomment -%}
    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- comment -%} Cart drawer shell, hydrated by kk.js (Section Rendering API). {%- endcomment -%}
    <div id="CartDrawer" class="kk-drawer" aria-hidden="true" aria-label="Cart" role="dialog">
      <div class="kk-drawer__overlay" data-drawer-close></div>
      <aside class="kk-drawer__panel" tabindex="-1">
        <header class="kk-drawer__head">
          <strong>Your Cart</strong>
          <button class="kk-drawer__x" data-drawer-close aria-label="Close cart">&times;</button>
        </header>
        <div class="kk-drawer__ship">
          <div class="kk-drawer__bar"><span data-ship-bar style="width:0%"></span></div>
          <p data-ship-msg class="kk-drawer__shipmsg"></p>
        </div>
        <div data-drawer-body class="kk-drawer__body"></div>
        <div class="kk-drawer__upsell" data-drawer-upsell></div>
        <footer class="kk-drawer__foot">
          <div class="kk-drawer__total"><span>Subtotal</span><span data-drawer-total></span></div>
          <a href="{{ routes.cart_url }}/checkout" class="kk-btn kk-btn--primary kk-btn--full">Checkout</a>
          <p class="kk-drawer__reassure">✓ Free shipping $100+ · ✓ 30-day money-back guarantee</p>
        </footer>
      </aside>
    </div>

    <script>window.kkFreeShipThreshold = {{ settings.free_ship_threshold | default: 100 | times: 100 }};</script>
    <script src="{{ 'kk.js' | asset_url }}" defer></script>
  </body>
</html>
